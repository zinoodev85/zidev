        if cwd not in d["projects"]:
            d["projects"].append(cwd)
    if server_running():
        wins = session_windows()
        for s in load_state()["sessions"]:
            if s["cwd"] == cwd and s["id"] not in wins and os.path.isdir(cwd):
                spawn_window(s)
