# ── storage ────────────────────────────────────────────────────────────────

def read_json(path, default):
    try:
        with open(path) as f:
            return json.load(f)
    except (OSError, ValueError):
        return default


def write_json(path, data):
    tmp = f"{path}.{os.getpid()}.tmp"
    with open(tmp, "w") as f:
        json.dump(data, f, indent=2)
    os.replace(tmp, path)


def load_state():
    d = read_json(STATE, {})
    d.setdefault("projects", [])
    d.setdefault("sessions", [])
    d.setdefault("collapsed", [])
    d.setdefault("changes_open", [])  # projects whose changed files show under the changes tab
    for s in d["sessions"]:  # the files pane became the commands bar
        if "files" in s:
            s["cmds"] = s.pop("files")
    return d


@contextlib.contextmanager
def edit_state():
    with open(LOCK, "w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        d = load_state()
        yield d
        write_json(STATE, d)


def read_status(zid):
    return read_json(f"{STATUS_DIR}/{zid}.json", {})


def set_status(zid, state, detail=""):
    path = f"{STATUS_DIR}/{zid}.json"
    st = read_json(path, {})
    if st.get("state") != state:
        st["since"] = time.time()
    st.update(state=state, detail=detail)
    write_json(path, st)


def seen_at(zid):
    try:
        return os.path.getmtime(f"{SEEN_DIR}/{zid}")
    except OSError:
        return 0


def mark_seen(zid):
    path = f"{SEEN_DIR}/{zid}"
    try:
        os.utime(path)
    except OSError:
        open(path, "w").close()


def migrate_home():
    """zmux → zidev: move ~/.zmux to ~/.zidev once, leaving a symlink for old tools."""
    old = os.path.expanduser("~/.zmux")
    if os.environ.get("ZIDEV_HOME") or os.path.exists(HOME) or not os.path.isdir(old) or os.path.islink(old):
        return
    os.rename(old, HOME)
    os.symlink(HOME, old)
    with contextlib.suppress(OSError):
        os.rename(f"{HOME}/zmux.log", LOG)


def old_server_running():
    """A tmux server from before the rename (socket "zmux") with the same sessions."""
    return (SOCKET == "zidev" and subprocess.run(["tmux", "-L", "zmux", "has-session"],
                                                  capture_output=True).returncode == 0)


def setup_dirs():
    for d in (HOME, STATUS_DIR, SEEN_DIR, ANCHOR):
        os.makedirs(d, exist_ok=True)
    hook = {"type": "command", "command": f"{shlex.quote(sys.executable)} {shlex.quote(SELF)} hook",
            "timeout": 5}
    write_json(HOOK_SETTINGS, {"hooks": {e: [{"hooks": [hook]}] for e in HOOK_EVENTS}})


def log(msg):
    with open(LOG, "a") as f:
        f.write(f"{time.strftime('%F %T')} {msg}\n")


# ── tmux ───────────────────────────────────────────────────────────────────

def tmux(*args):
    """Run a tmux command on the zidev server; stdout, or None on failure."""
    r = subprocess.run(["tmux", "-L", SOCKET, *args], capture_output=True, text=True)
    return r.stdout.strip() if r.returncode == 0 else None


def self_cmd(*args):
    return "exec " + " ".join(shlex.quote(a) for a in (sys.executable, SELF, *args))


def server_running():
    return tmux("has-session", "-t", SESSION) is not None


def session_windows(strict=False):
    """{zidev id: tmux window id} for every session window; strict: None when tmux did not answer."""
    out = tmux("list-windows", "-t", SESSION, "-F", "#{window_id} #{@zidev_id}")
    if out is None and strict:
        return None
    wins = {}
    out = out or ""
    for line in out.splitlines():
        wid, _, zid = line.partition(" ")
        if zid:
            wins[zid] = wid
    return wins


def add_sidebar(wid):
    tmux("split-window", "-h", "-b", "-d", "-l", str(sidebar_width()), "-t", wid, self_cmd("sidebar"))


def spawn_window(s, select=False):
    out = tmux("new-window", "-d", "-P", "-F", "#{window_id} #{pane_id}", "-t", f"{SESSION}:",
               "-c", s["cwd"], "-e", f"ZIDEV_ID={s['id']}", "-n", project_name(s["cwd"]),
               self_cmd("run", s["id"]))
    if not out:
        return None
    wid, claude = out.split()
    tmux("set-option", "-w", "-t", wid, "@zidev_id", s["id"])
    mark_tab(claude, s["cwd"], "claude", owner=s["id"])
    add_sidebar(wid)
    if select:
        show_window(wid)
    return wid


# ── tabs ───────────────────────────────────────────────────────────────────
# Arc-style: right of the sidebar one tab fills the window, never split. Each session window shows
# its Claude or one of its project's tabs (terminal, commands, files, git): those belong to the
# project, shared by its sessions, and are listed under the project in the sidebar. Tabs not shown
# wait in the hidden PARK session and swap in when picked. A Claude only ever shows in its own
# window. A clicked file opens as a floating preview over the tab; enter docks it as a tab.

PARK = "zidev-park"
TAB_KINDS = ("claude", "term", "cmds", "file", "git")
TAB_FIELDS = {"pane": "pane_id", "session": "session_name", "window": "window_id", "owner": "@zidev_owner",
              "project": "@zidev_project", "kind": "@zidev_side", "order": "@zidev_order", "used": "@zidev_used",
              "label": "@zidev_label", "file": "@zidev_file", "float": "pane_floating_flag",
              "cmd": "pane_current_command"}
SHELLS = ("zsh", "bash", "fish", "sh", "-zsh", "-bash", "login")


def tmux_all(*cmds):
    """Several tmux commands in one call."""
    args = []
    for c in cmds:
        args += [*c, ";"]
    return tmux(*args[:-1]) if args else ""


def all_tabs(strict=False):
    """Every tab; strict: None when tmux did not answer (not: there are none)."""
    out = tmux("list-panes", "-a", "-F", "\t".join(f"#{{{f}}}" for f in TAB_FIELDS.values()))
    if out is None and strict:
        return None
    out = out or ""
    tabs = []
    for line in out.splitlines():
        t = dict(zip(TAB_FIELDS, line.split("\t")))
        if t.get("kind") not in TAB_KINDS or not t.get("project"):
            continue
        for k in ("order", "used"):
            t[k] = int(t[k]) if t[k].isdigit() else 0
        t["float"] = t["float"] == "1"
        t["visible"] = t["session"] == SESSION
        tabs.append(t)
    return sorted(tabs, key=lambda t: t["order"])


def project_tabs(cwd, tabs=None):
    """A project's docked tabs besides its Claudes."""
    return [t for t in (all_tabs() if tabs is None else tabs)
            if t["project"] == cwd and t["kind"] != "claude" and not t["float"]]


def claude_tab(zid, tabs=None):
    return next((t for t in (all_tabs() if tabs is None else tabs) if t["kind"] == "claude" and t["owner"] == zid), None)


def shown_in(wid, tabs=None):
    """The tab filling a session window."""
    return next((t for t in (all_tabs() if tabs is None else tabs) if t["window"] == wid and not t["float"]), None)


def floating_in(wid, tabs=None):
    return next((t for t in (all_tabs() if tabs is None else tabs) if t["window"] == wid and t["float"]), None)


def window_zid(wid, wins=None):
    return next((z for z, w in (session_windows() if wins is None else wins).items() if w == wid), None)


def last_session(cwd, tabs=None, wins=None):
    """The project's session whose window was used last: where its tabs show by default."""
    tabs, wins = all_tabs() if tabs is None else tabs, session_windows() if wins is None else wins
    used = {}
    for t in tabs:
        z = window_zid(t["window"], wins) if t["visible"] else None
        if z and t["project"] == cwd:
            used[z] = max(used.get(z, 0), t["used"])
    return max(used, key=used.get) if used else None


def tab_label(kind, file=None):
    return {"claude": "Claude", "term": "terminal", "cmds": "commands", "git": "changes"}.get(kind) \
        or os.path.basename(file or "file")


def tab_cmd(kind, cwd, file=None, line=None):
    if kind == "file":
        return self_cmd("view", file, str(line or ""))
    return self_cmd(kind, cwd, *([file] if kind == "git" and file else []))  # changes: of one file


def next_seq():
    seq = int(tmux("show", "-gv", "@zidev_seq") or 0) + 1
    tmux("set", "-g", "@zidev_seq", str(seq))
    return seq


def mark_tab(pane, cwd, kind, file=None, owner=None):
    seq = str(next_seq())
    opts = {"@zidev_project": cwd, "@zidev_side": kind, "@zidev_order": seq, "@zidev_used": seq,
            "@zidev_label": tab_label(kind, file), "@zidev_file": file or ""}
    if owner:
        opts["@zidev_owner"] = owner
    tmux_all(*(["set", "-p", "-t", pane, k, v] for k, v in opts.items()))


def ensure_park():
    if tmux("has-session", "-t", PARK) is None:
        tmux("new-session", "-d", "-s", PARK, "-n", "_", "-x", "200", "-y", "50", "exec sleep 2147483647")


def spawn_parked(cwd, kind, file=None, line=None):
    ensure_park()
    return tmux("new-window", "-d", "-P", "-F", "#{pane_id}", "-t", f"{PARK}:", "-c", cwd,
                tab_cmd(kind, cwd, file, line))


def file_tab(cwd, path):
    """The project's docked tab of file path, if it has one (a file is open at most once)."""
    return next((t for t in project_tabs(cwd) if t["kind"] == "file" and t["file"] == path), None)


def reuse_file_tab(zid, cwd, path, line=None):
    """Show the file's tab instead of opening it again (at line, when given); its pane, or None."""
    t = file_tab(cwd, path)
    if not t:
        return None
    if line:
        tmux("respawn-pane", "-k", "-t", t["pane"], "-c", os.path.dirname(path), tab_cmd("file", cwd, path, line))
    select_tab(t["pane"], zid)
    return t["pane"]


def new_tab(zid, kind, file=None, line=None):
    """Open a project tab and show it in the window of session zid."""
    s = session_of(zid)
    if not s or zid not in session_windows():
        return None
    if kind == "file" and file_tab(s["cwd"], file):
        return reuse_file_tab(zid, s["cwd"], file, line)
    pane = spawn_parked(s["cwd"], kind, file, line)
    if pane:
        mark_tab(pane, s["cwd"], kind, file)
        select_tab(pane, zid)
    return pane


def find_tab(pane, tabs=None):
    return next((t for t in (all_tabs() if tabs is None else tabs) if t["pane"] == pane), None)


def swap_in(t, shown):
    """Put parked tab t where pane `shown` is (that one goes to the park)."""
    tmux("swap-pane", "-d", "-s", t["pane"], "-t", shown)
    if t["kind"] == "file" and is_markdown(t["file"]):  # glow renders at its start width: restart it
        tmux("respawn-pane", "-k", "-t", t["pane"], "-c", os.path.dirname(t["file"]),
             tab_cmd("file", t["project"], t["file"]))
    elif t["kind"] == "git":  # the changes as they are now
        tmux("respawn-pane", "-k", "-t", t["pane"], "-c", t["project"], tab_cmd("git", t["project"], t["file"]))


def show_changes(t, file, zid, focus=True):
    """The changes tab with the diff of one changed file ("": the first)."""
    tmux("set", "-p", "-t", t["pane"], "@zidev_file", file)
    if t["visible"]:
        tmux("respawn-pane", "-k", "-t", t["pane"], "-c", t["project"], tab_cmd("git", t["project"], file))
    return select_tab(t["pane"], zid, focus)  # a parked one is redrawn as it swaps in


def fill_window(t, wid):
    """An empty session window (its shown tab died): tab t fills it."""
    width = int(tmux("display", "-p", "-t", wid, "#{window_width}") or 200)
    tmux("join-pane", "-d", "-h", "-l", str(max(20, width - sidebar_width() - 1)), "-s", t["pane"],
         "-t", f"{wid}.0")


def vacate(t, wins, tabs):
    """Take shown tab t out of its window: that window shows its Claude again."""
    claude = claude_tab(window_zid(t["window"], wins), tabs)
    if claude and not claude["visible"]:
        swap_in(claude, t["pane"])
    else:
        ensure_park()
        tmux("break-pane", "-d", "-s", t["pane"], "-t", f"{PARK}:")


def select_tab(pane, zid=None, focus=True):
    """Show a tab and focus it: a project tab in the window of session zid (default: where it is
    shown, else the project's last used window), a Claude in its own window."""
    tabs, wins = all_tabs(), session_windows()
    t = find_tab(pane, tabs)
    if not t:
        return False
    if t["kind"] == "claude":
        zid = t["owner"]
    elif t["float"] or (t["visible"] and not zid):
        zid = window_zid(t["window"], wins)
    zid = zid or last_session(t["project"], tabs, wins)
    wid = wins.get(zid)
    if not wid:
        return False
    if t["window"] != wid:
        if t["visible"]:
            vacate(t, wins, tabs)
        shown = shown_in(wid, tabs)
        if shown:
            swap_in(t, shown["pane"])
        else:
            fill_window(t, wid)
    tmux("set", "-p", "-t", pane, "@zidev_used", str(next_seq()))
    if focus:
        tmux_all(["select-window", "-t", wid], ["select-pane", "-t", pane])
    settle(wid)
    sync_tabs(t["project"])
    return True


def window_choices(zid, tabs=None):
    """What session zid's window can show, in sidebar order: its Claude, then its project's tabs."""
    tabs = all_tabs() if tabs is None else tabs
    claude = claude_tab(zid, tabs)
    return ([claude] if claude else []) + (project_tabs(claude["project"], tabs) if claude else [])


def sidebar_hidden():
    return tmux("show", "-gv", "@zidev_hidden") == "1"


def split_of(zid):
    """The terminal next to session zid's Claude (cmd-t), shown or parked: (pane, window) or (None, None)."""
    out = tmux("list-panes", "-a", "-F", "#{pane_id}\t#{@zidev_side}\t#{@zidev_owner}\t#{window_id}") or ""
    return next(((p, w) for p, k, o, w in (l.split("\t") for l in out.splitlines()) if k == "split" and o == zid),
                (None, None))


def settle(wid=None):
    """After the shown tab changed: Claude's side terminal is next to it only while Claude shows
    (parked otherwise); a hidden sidebar (cmd-b) stays hidden. tmux unzooms on every swap or join,
    so this runs after each. Not while a preview floats (it would be zoomed away)."""
    wins = session_windows()
    for zid, w in [(window_zid(wid, wins), wid)] if wid else wins.items():
        if not zid:
            continue
        shown = shown_in(w)
        pane, at = split_of(zid)
        want = bool(shown and shown["kind"] == "claude"
                    and tmux("show", "-pv", "-t", shown["pane"], "@zidev_split") == "1")
        if want and not pane:  # its shell ended
            tmux("set", "-p", "-t", shown["pane"], "@zidev_split", "0")
            want = False
        elif pane and at == w and not want:
            ensure_park()
            tmux("break-pane", "-d", "-s", pane, "-t", f"{PARK}:")
        elif pane and at != w and want:
            tmux("join-pane", "-d", "-h", "-l", "40%", "-s", pane, "-t", shown["pane"])
        zoomed = tmux("display", "-p", "-t", w, "#{window_zoomed_flag}") == "1"
        side = int(tmux("display", "-p", "-t", f"{w}.0", "#{pane_width}") or 0)
        if sidebar_hidden() and not floating_in(w):
            if want:  # zoom would hide the terminal too: the sidebar shrinks to a sliver instead
                if zoomed:
                    tmux("resize-pane", "-Z", "-t", f"{w}.1")
                tmux("resize-pane", "-t", f"{w}.0", "-x", "1")
            elif not zoomed:
                tmux_all(["select-pane", "-t", f"{w}.1"], ["resize-pane", "-Z", "-t", f"{w}.1"])
        else:
            if zoomed:
                tmux("resize-pane", "-Z", "-t", f"{w}.1")
            if side < SIDEBAR_MIN:
                tmux("resize-pane", "-t", f"{w}.0", "-x", str(sidebar_width()))
        if want:  # 40 % of what is right of the sidebar, however the sidebar changed
            room = tmux("display", "-p", "-t", f"{w}.0", "#{window_width} #{pane_width}")
            if room:
                win, bar = map(int, room.split())
                tmux("resize-pane", "-t", split_of(zid)[0], "-x", str(max(10, (win - bar - 2) * 2 // 5)))


def toggle_split(pane):
    """cmd-t: a terminal next to the session's Claude, or away again (it keeps running, parked)."""
    zid = zid_of_pane(pane)
    wid, claude = session_windows().get(zid), claude_tab(zid)
    if not wid or not claude:
        return
    on = tmux("show", "-pv", "-t", claude["pane"], "@zidev_split") == "1"
    if (shown_in(wid) or {}).get("pane") != claude["pane"]:  # another tab shows: Claude with its terminal
        on = False
        select_tab(claude["pane"], zid)
    tmux("set", "-p", "-t", claude["pane"], "@zidev_split", "0" if on else "1")
    split, _ = split_of(zid)
    if not on and not split:
        split = tmux("split-window", "-d", "-h", "-l", "40%", "-t", claude["pane"], "-c", claude["project"],
                     "-e", f"ZIDEV_ID={zid}", "-P", "-F", "#{pane_id}")
        tmux_all(["set", "-p", "-t", split, "@zidev_side", "split"], ["set", "-p", "-t", split, "@zidev_owner", zid],
                 ["set", "-p", "-t", split, "@zidev_project", claude["project"]])
    settle(wid)
    tmux("select-pane", "-t", claude["pane"] if on else split)


def toggle_sidebar():
    tmux("set", "-g", "@zidev_hidden", "0" if sidebar_hidden() else "1")
    settle()


def cycle_tab(pane, delta, items=False):
    """The next / previous tab of the window; items: in sidebar order, Claude, terminals and files
    only (cmd-↑ / cmd-↓), no wrap."""
    zid = zid_of_pane(pane)
    wid = session_windows().get(zid)
    tabs = all_tabs()
    choices, shown = window_choices(zid, tabs), shown_in(wid, tabs)
    if items:
        choices = [t for t in choices if t["kind"] in ("claude", "term", "file")]
        i = next((n for n, t in enumerate(choices) if shown and t["pane"] == shown["pane"]), None)
        j = 0 if i is None else i + delta
        if 0 <= j < len(choices) and j != i:
            select_tab(choices[j]["pane"], zid)
        return
    i = next((n for n, t in enumerate(choices) if shown and t["pane"] == shown["pane"]), 0)
    if len(choices) > 1:
        select_tab(choices[(i + delta) % len(choices)]["pane"], zid)


def close_tab(pane):
    """Close a tab (never a Claude); its window shows the tab used before it. A project's own
    terminal and changes tab stay: they restart, parked."""
    tabs, wins = all_tabs(), session_windows()
    t = find_tab(pane, tabs)
    if not t or t["kind"] == "claude":
        return
    keep = t["kind"] in ALWAYS and [x["pane"] for x in project_tabs(t["project"], tabs) if x["kind"] == t["kind"]] == [pane]
    if t["visible"] and not t["float"]:
        zid = window_zid(t["window"], wins)
        rest = [x for x in window_choices(zid, tabs) if x["pane"] != pane and not x["visible"]]
        if rest:
            nxt = max(rest, key=lambda x: x["used"])
            swap_in(nxt, pane)
            tmux("set", "-p", "-t", nxt["pane"], "@zidev_used", str(next_seq()))
            if tmux("display", "-p", "-t", pane, "#{pane_active}") == "1":
                tmux("select-pane", "-t", nxt["pane"])
    if keep:
        sync_tabs(t["project"])
        tmux_all(["set", "-p", "-t", pane, "@zidev_file", ""],  # last: may be this very process
                 ["respawn-pane", "-k", "-t", pane, "-c", t["project"], tab_cmd(t["kind"], t["project"])])
        return
    tmux("kill-pane", "-t", pane)
    settle(t["window"])
    sync_tabs(t["project"])


ALWAYS = ("term", "git")  # every project has a terminal and (in a git repo) a changes tab


@contextlib.contextmanager
def tabs_lock():
    """One zidev at a time makes tabs: two starting together (iTerm and the app) would each make them all."""
    with open(f"{HOME}/tabs.lock", "w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        yield


def ensure_project_tabs():
    """Give each project its terminal and changes tab, parked, when it has none."""
    with tabs_lock():
        _ensure_project_tabs()


def _ensure_project_tabs():
    tabs = all_tabs(strict=True)
    if tabs is None:  # tmux did not answer: that is not "no tabs"
        return
    d = load_state()
    for cwd in dict.fromkeys(d["projects"] + [s["cwd"] for s in d["sessions"]]):
        if not os.path.isdir(cwd) or cwd in d.get("archived", []):
            continue
        have = {t["kind"] for t in project_tabs(cwd, tabs)}
        repo = subprocess.run(["git", "-C", cwd, "rev-parse", "--git-dir"], capture_output=True).returncode == 0
        for kind in ALWAYS:
            if kind not in have and (kind != "git" or repo):
                pane = spawn_parked(cwd, kind)
                if pane:
                    mark_tab(pane, cwd, kind)
        if not have.issuperset(ALWAYS):
            sync_tabs(cwd)


def show_kind(zid, kind):
    """In session zid's window: its project's last used tab of a kind (terminal, commands, git), or a new one."""
    cwd = session_of(zid).get("cwd")
    same = [t for t in project_tabs(cwd) if t["kind"] == kind] if cwd else []
    if same:
        return select_tab(max(same, key=lambda t: t["used"])["pane"], zid)
    new_tab(zid, kind)


def preview(zid, path, line=None):
    """Show a file in the window's floating preview (reused for the next file; enter docks it)."""
    s, wid = session_of(zid), session_windows().get(zid)
    if not s or not wid:
        return
    if file_tab(s["cwd"], path):  # already a tab: show that one
        floating = floating_in(wid)
        if floating:
            tmux("kill-pane", "-t", floating["pane"])
        reuse_file_tab(zid, s["cwd"], path, line)
        return
    cmd = tab_cmd("file", s["cwd"], path, line)
    floating = floating_in(wid)
    if floating:
        tmux("respawn-pane", "-k", "-t", floating["pane"], "-c", s["cwd"], cmd)
        tmux_all(["set", "-p", "-t", floating["pane"], "@zidev_file", path],
                 ["set", "-p", "-t", floating["pane"], "@zidev_label", tab_label("file", path)],
                 ["select-pane", "-t", floating["pane"]])
        return
    pane = float_pane(wid, s["cwd"], cmd)
    if pane:
        mark_tab(pane, s["cwd"], "file", path)


def float_pane(wid, cwd, cmd):
    """A floating pane over everything right of the sidebar (small margin); its id."""
    geo = tmux("display", "-p", "-t", f"{wid}.1", "#{pane_left} #{window_width} #{window_height}")
    if not geo:
        return None
    left, width, height = map(int, geo.split())
    x, w = left + 2, max(20, width - left - 4)
    return tmux("new-pane", "-P", "-F", "#{pane_id}", "-t", f"{wid}.1", "-x", str(w), "-y", str(max(8, height - 2)),
                "-X", str(x), "-Y", "1", "-c", cwd, cmd)


def pin_tab(pane):
    """Dock the floating preview as a tab."""
    t = find_tab(pane)
    if not (t and t["float"]):
        wid = tmux("display", "-p", "-t", pane, "#{window_id}")
        t = floating_in(wid) if wid else None
    if not t:
        return
    zid = window_zid(t["window"])
    if t["kind"] == "file" and file_tab(t["project"], t["file"]):  # already docked: that tab, not a second
        tmux("kill-pane", "-t", t["pane"])
        reuse_file_tab(zid, t["project"], t["file"])
        return
    ensure_park()
    tmux("break-pane", "-d", "-s", t["pane"], "-t", f"{PARK}:")
    select_tab(t["pane"], zid)


def repair_tabs():
    """Session windows whose shown tab died: their Claude (else the tab used last) fills them.
    A parked Claude whose session is gone: closed."""
    tabs, wins = all_tabs(), session_windows()
    for t in tabs:
        if t["kind"] == "claude" and t["owner"] not in wins and not t["visible"]:
            tmux("kill-pane", "-t", t["pane"])
    for line in (tmux("list-panes", "-t", PARK, "-s", "-F", "#{pane_id}\t#{@zidev_side}\t#{@zidev_owner}") or "").splitlines():
        p, kind, owner = line.split("\t")
        if kind == "split" and owner not in wins:  # its session is gone
            tmux("kill-pane", "-t", p)
    for zid, wid in wins.items():
        if shown_in(wid, tabs):
            continue
        parked = [t for t in window_choices(zid, tabs) if not t["visible"]]
        if parked:
            fill_window(parked[0] if parked[0]["kind"] == "claude" else max(parked, key=lambda t: t["used"]), wid)


def sync_tabs(cwd, tabs=None):
    """Save a project's tabs (restored after a restart). An archived one's stay as saved."""
    if cwd in archived():
        return
    tabs, wins = all_tabs(strict=True) if tabs is None else tabs, session_windows(strict=True)
    if tabs is None or wins is None:  # tmux did not answer: keep what is saved
        return
    saved = [{"kind": t["kind"], "file": t["file"] or None,
              "shown_in": window_zid(t["window"], wins) if t["visible"] else None} for t in project_tabs(cwd, tabs)]
    with edit_state() as d:
        d.setdefault("project_tabs", {})[cwd] = saved
        for s in d["sessions"]:
            if s["cwd"] == cwd:
                for k in ("tabs", "term", "cmds"):
                    s.pop(k, None)


def saved_tabs(d, cwd):
    """A project's tabs to restore; from before they were the project's: its sessions' tabs."""
    if cwd in d.get("project_tabs", {}):
        return d["project_tabs"][cwd]
    old = []
    for s in (s for s in d["sessions"] if s["cwd"] == cwd):
        if "tabs" in s:
            old += [{"kind": t["kind"], "file": t.get("file"), "shown_in": s["id"] if t.get("active") else None}
                    for t in s["tabs"]]
        old += [{"kind": k, "file": None, "shown_in": None} for k in ("term", "cmds") if s.get(k)]
    return list({(t["kind"], t["file"]): t for t in reversed(old)}.values())[::-1]  # one of each


def one_of(tabs):
    """A project has one changes tab and each file once: the rest of them are extra."""
    seen = set()
    for t in tabs:
        key = ("git",) if t["kind"] == "git" else ("file", t.get("file")) if t["kind"] == "file" else None
        if key and key in seen:
            yield t
        seen.add(key)


def restore_tabs():
    """After a start: every project's saved tabs, parked or shown where they were."""
    with tabs_lock():
        _restore_tabs()


def _restore_tabs():
    d, tabs = load_state(), all_tabs(strict=True)
    if tabs is None:  # tmux did not answer: that is not "no tabs"
        return
    for cwd in dict.fromkeys(d["projects"] + [s["cwd"] for s in d["sessions"]]):
        have = [t for t in project_tabs(cwd, tabs) if not t["visible"]]
        extra = list(one_of(have))
        for t in extra:  # made twice before: one is enough
            tmux("kill-pane", "-t", t["pane"])
        if extra:
            sync_tabs(cwd)
        if project_tabs(cwd, tabs) or not os.path.isdir(cwd) or cwd in d.get("archived", []):
            continue
        shown = set()
        saved = saved_tabs(d, cwd)
        extra = list(one_of(saved))
        for t in saved:
            if any(t is e for e in extra):
                continue
            if t["kind"] not in TAB_KINDS[1:] or (t["kind"] == "file" and not os.path.isfile(t.get("file") or "")):
                continue
            pane = spawn_parked(cwd, t["kind"], t.get("file"))
            if not pane:
                continue
            mark_tab(pane, cwd, t["kind"], t.get("file"))
            if t.get("shown_in") and t["shown_in"] not in shown:
                shown.add(t["shown_in"])
                select_tab(pane, t["shown_in"], focus=False)
        sync_tabs(cwd)


def zid_of_pane(pane):
    """The session a pane is about: its window's, a Claude's own; parked: ZIDEV_ID."""
    out = tmux("display", "-p", "-t", pane, "#{@zidev_id}\t#{@zidev_owner}") if pane else None
    zid, _, owner = (out or "").partition("\t")
    return owner or zid or os.environ.get("ZIDEV_ID")


def show_window(wid):
    tmux("select-window", "-t", wid)
    tmux("select-pane", "-t", f"{wid}.1")


SKILL_DIR = os.environ.get("ZIDEV_SKILL_DIR") or os.path.expanduser("~/.claude/skills/zidev")
SKILL = """---
name: zidev
description: What zidev is and how to work inside it. Use when running in a zidev session (env ZIDEV_ID is set), when the user mentions zidev, its sidebar, tabs, preview or changes tab, or asks to rename the project, show them a file, or open a new session.
---

# zidev

zidev is the user's place for Claude Code sessions: a tmux server (socket `zidev`, `tmux -L zidev`) with a
sidebar of projects on the left (Arc-style, no tab bar). Each project lists its Claude sessions with live status
(working / needs you / finished) and its tabs: terminals, the changes tab, commands, files. The selected item fills
the rest of the window. Sessions keep running when the terminal closes and come back after a reboot.

You are inside zidev when `ZIDEV_ID` is set: it is your session's id. Your project is your session's folder.

## What you can do for the user

- Show a file: write `path:line` (e.g. `src/a.ts:42`) in your answer; a click opens a preview at that line.
  Or open it yourself: `zidev open FILE[:LINE]` (preview), `zidev open FILE --tab` (a tab under the project).
- Web links in your output open in the browser on a plain click.
- Rename your project in the sidebar (the folder stays): `zidev rename-project "Name"`; `""` gives back the folder name.
- A new session in another folder: `zidev new DIR`. Give it its task right away: `zidev new DIR --prompt "…"`
  (Claude's first message, sent when the session starts).
- Sessions and their status: `zidev list --json`.

## Do not

- `zidev kill` or `tmux -L zidev kill-server`: stops every session of the user (only when developing zidev, see below).
- Change tmux options or key bindings of the `zidev` server.

## Keys (so you can tell the user)

Sidebar:
{keys}

Everywhere: cmd-b hide / show sidebar · cmd-↑ / cmd-↓ item above / below · cmd-t terminal next to Claude ·
cmd-shift-t new terminal tab · cmd-w close tab · esc closes preview, viewer, changes, editor (no q) · ctrl-q menu.
Preview: esc close, ⏎ keep as tab, e edit, l line numbers. Editor (micro): usual mac keys (cmd-x / c / v / f / a / s / z).

## CLI
{cli}

## Developing zidev itself

Source: `{source}` (one Python file). Decisions: `{intent}` (only the user's decisions; keep it updated).
After each change: `zidev selftest` (throwaway server, never touches real sessions), then `zidev kill` and a new
iTerm window with profile "zidev". This skill is written by zidev on start from the `SKILL` text in the source:
change it there, not here.
"""


def install_skill():
    """The agent skill about zidev (~/.claude/skills/zidev), rewritten on start when zidev changed."""
    keys = "\n".join(f"- `{k}` {text}" for k, text in Sidebar.HELP if k)
    cli = "\n".join(l for l in __doc__.splitlines() if l.startswith("  zidev"))
    text = SKILL.replace("{keys}", keys).replace("{cli}", f"\n```\n{cli}\n```").replace("{source}", SELF) \
        .replace("{intent}", os.path.join(HERE, "intent.md"))
    path = f"{SKILL_DIR}/SKILL.md"
    if not os.path.exists(path) or open(path).read() != text:
        os.makedirs(SKILL_DIR, exist_ok=True)
        with open(path, "w") as f:
            f.write(text)


def ensure_server():
    """Start the tmux server with every saved session, or fill in missing windows."""
    setup_dirs()
    install_skill()
    fresh = not server_running()
    if fresh:
        home = subprocess.run(
            ["tmux", "-L", SOCKET, "-f", TMUX_CONF, "new-session", "-d", "-P", "-F", "#{window_id}",
             "-s", SESSION, "-n", "home", "-c", os.path.expanduser("~"), "-x", "200", "-y", "50",
             self_cmd("welcome")],
            capture_output=True, text=True, check=True).stdout.strip()
        add_sidebar(home)
    else:
        tmux("source-file", TMUX_CONF)
    install_tmux_hooks()
    wins = session_windows()
    d = load_state()
    for s in d["sessions"]:
        if s["id"] not in wins and os.path.isdir(s["cwd"]) and s["cwd"] not in d.get("archived", []):
            wins[s["id"]] = spawn_window(s)
    restore_tabs()
    ensure_project_tabs()
    if fresh:
        last = load_state().get("last")
        if last in wins:
            show_window(wins[last])


def sidebar_width():
    with contextlib.suppress(TypeError, ValueError):
        return max(SIDEBAR_MIN, int(read_json(CONFIG, {}).get("sidebar_w", SIDEBAR_W)))
    return SIDEBAR_W


def restart_claude(s, wid):
    claude = (claude_tab(s["id"]) or {}).get("pane", f"{wid}.1")
    tmux("respawn-pane", "-k", "-t", claude, "-c", s["cwd"], "-e", f"ZIDEV_ID={s['id']}",
         self_cmd("run", s["id"]))
    select_tab(claude)


def new_session(cwd, select=True, prompt=None):
    cwd = os.path.realpath(os.path.expanduser(cwd))
    s = {"id": str(uuid.uuid4()), "cwd": cwd, "title": "", "created": time.time()}
    if prompt:
        s["prompt"] = prompt  # Claude's first message, sent once on its first start
    if cwd in archived():  # a new session brings the project back
        unarchive_project(cwd)
    with edit_state() as d:
        d["sessions"].append(s)
        if cwd not in d["projects"]:
            d["projects"].append(cwd)
        if cwd in d["collapsed"]:
            d["collapsed"].remove(cwd)
    set_status(s["id"], "idle")
    if server_running():
        spawn_window(s, select)
        ensure_project_tabs()
    return s


def close_session(zid):
    with edit_state() as d:
        d["sessions"] = [s for s in d["sessions"] if s["id"] != zid]
    for path in (f"{STATUS_DIR}/{zid}.json", f"{SEEN_DIR}/{zid}"):
        with contextlib.suppress(OSError):
            os.remove(path)
    wid = session_windows().get(zid)
    if wid:
        tabs = all_tabs()
        shown, claude = shown_in(wid, tabs), claude_tab(zid, tabs)
        if shown and shown["kind"] != "claude":  # the project's tab outlives the session
            ensure_park()
            tmux("break-pane", "-d", "-s", shown["pane"], "-t", f"{PARK}:")
        if claude and not claude["visible"]:
            tmux("kill-pane", "-t", claude["pane"])
        tmux("kill-window", "-t", wid)  # last: may be the caller's own window


_names = (None, {})


def project_name(cwd):
    """The name given to the project (r on its row, zidev rename-project), else its folder's."""
    global _names
    try:
        mtime = os.stat(STATE).st_mtime_ns
    except OSError:
        mtime = None
    if _names[0] != mtime:  # the sidebar asks on every draw: read the file only when it changed
        _names = (mtime, load_state().get("names", {}))
    return _names[1].get(cwd) or os.path.basename(cwd.rstrip("/")) or cwd


def rename_project(cwd, name):
    """Give a project a display name; "" gives it back its folder's name."""
    with edit_state() as d:
        names = d.setdefault("names", {})
        if name.strip():
            names[cwd] = name.strip()
        else:
            names.pop(cwd, None)


def cmd_rename_project(args):
    """zidev rename-project [PATH] NAME: PATH defaults to this session's project (else the current folder)."""
    if not args:
        sys.exit("usage: zidev rename-project [PATH] NAME   (NAME \"\" gives back the folder's name)")
    d = load_state()
    if len(args) == 1:
        own = next((s["cwd"] for s in d["sessions"] if s["id"] == os.environ.get("ZIDEV_ID")), None)
        path, name = own or os.getcwd(), args[0]
    else:
        path, name = args[0], " ".join(args[1:])
    cwd = os.path.realpath(path)
    if cwd not in d["projects"] + [s["cwd"] for s in d["sessions"]]:
        sys.exit(f"not a zidev project: {cwd}")
    rename_project(cwd, name)
    print(f"{cwd} → {project_name(cwd)}")


