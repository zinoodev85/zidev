LOOKS_LIKE_FILE = re.compile(r"^[\w.~@+-]*/[\w./@+-]*\.[A-Za-z][A-Za-z0-9]{0,7}(:\d+(:\d+)?)?[.:,]?$")


def color_runs(row):
    """A captured row (capture-pane -e) as runs of one color: [(first column, end column, text, color)]."""
    import unicodedata
    runs, state, col = [], "", 0
    for seq, ch in re.findall(r"\033\[([0-9;]*)m|(.)", row, re.S):
        if not ch:
            state = "" if seq in ("", "0") else state + ";" + seq
            continue
        n = 2 if unicodedata.east_asian_width(ch) in "WF" else 1
        if runs and runs[-1][3] == state:
            runs[-1][1], runs[-1][2] = col + n, runs[-1][2] + ch
        else:
            runs.append([col, col + n, ch, state])
        col += n
    return [tuple(r) for r in runs]


def fg_of(state):
    """The text color a color_runs state ends on ("" for the default)."""
    codes, fg = [c for c in state.split(";") if c], ""
    while codes:
        c = codes.pop(0)
        if c == "38" and codes:
            n = 4 if codes[0] == "2" else 2
            fg, codes = ";".join(["38", *codes[:n]]), codes[n:]
        elif c in ("39", "0"):
            fg = ""
        elif c.isdigit() and (30 <= int(c) <= 37 or 90 <= int(c) <= 97):
            fg = c
        elif c == "48" and codes:
            codes = codes[4 if codes[0] == "2" else 2:]
    return fg


def bang_at(rows, y, x, width=None):
    """The `! command` Claude suggests under (x, y), without its !: its inline-code run (one color),
    or a row that is only "! command"; one that fills its row goes on at the start of the next
    (a long path wraps mid-word: joined without a space). A click on a wrapped part counts too."""
    rows = [re.sub(r"\033\]8;[^\033\a]*(\033\\|\a)", "", r) for r in rows]  # no hyperlinks
    if not 0 <= y < len(rows):
        return None
    hit = bang_from(rows, y, x, width)
    if hit:
        return hit[0]
    lead = next((r for r in color_runs(rows[y]) if r[2].strip()), None)
    if not lead or not lead[0] <= x < lead[1]:
        return None
    for up in range(1, 5):  # a wrapped part: the command starts a row or more above
        plain = ANSI.sub("", rows[max(y - up, 0)])
        hit = y - up >= 0 and bang_from(rows, y - up, len(plain.rstrip()) - 1, width)
        if hit and hit[1] >= y:
            return hit[0]
    return None


def bang_from(rows, y, x, width):
    """bang_at at its first row: (the command, the last row it wraps onto), or None."""
    plain = ANSI.sub("", rows[y])
    runs = color_runs(rows[y])
    indent = len(plain) - len(plain.lstrip())
    if re.match(r"\s*! ?\S", plain) and x >= indent:  # a line of its own
        first = next((r for r in runs if r[2].strip()), None)
        run = (indent, len(plain.rstrip()), plain.strip(), first[3] if first else "")
    else:
        run = next((r for r in runs if r[0] <= x < r[1]), None)
        alone = run and re.match(r"\s*!\s*$", run[2]) and run[1] >= len(plain.rstrip())  # "!" ends the row,
        if not run or not run[3] or not (re.match(r"\s*! ?\S", run[2]) or alone):  # the command on the next
            return None
    text, end, last = run[2], run[1], y
    for nxt in rows[y + 1:y + 5]:  # wrapped: the same color goes on after the indent
        if end < len(plain.rstrip()):
            break
        lead = next((r for r in color_runs(nxt) if r[2].strip()), None)
        if not lead or fg_of(lead[3]) != fg_of(run[3]) or lead[0] > 8 or lead[2].lstrip().startswith("!"):
            break
        word = lead[2].split()[0]  # wrapped: its first word did not fit after the row's end (a long hash
        if width and end + 1 + len(word) <= width:  # moves down whole, leaving the row short)
            break
        # cut mid-word at the edge, not at a space: only a word too long for a row of its own is cut
        # (`sed` ending at the edge and `-e` on the next row: a space between)
        full = width and end >= width - 2 and len(text.split()[-1]) + len(word) > width - lead[0]
        text = text.rstrip() + ("" if full else " ") + lead[2].strip()
        plain, end, last = ANSI.sub("", nxt), lead[1], last + 1
    cmd = text.strip()[1:].strip().strip("`")
    return (cmd, last) if cmd else None


SHORTHAND = re.compile(r"(?<![\w-])(?:[kyxnd](?: \d+)+|\d+[kyxnd?])(?![\w-])")


BULLET = r"\s*(?:[-–—*•·⏺]\s+)?"
CHOICES = re.compile(BULLET + r"(\d+[a-z]?)\.?((?:\s+[a-z?])+)\s*:")  # 42 y n ? / 8 a b ? : what item 42 is
ITEM = re.compile(BULLET + r"(\d+[a-z]?)\b")  # 42. / – 10a: an item's number


def shorthand_at(rows, y, x):
    """A reply shorthand under (x, y): "k 461", "k 1 2 3", "461k", "3?" (do / drop / explain item n),
    or one of an item's choices: the y in "42 y n ? : ..." is 42y, the a in "8 a b ? : ..." 8a; the number an item starts with is itself."""
    if not 0 <= y < len(rows):
        return None
    plain = ANSI.sub("", rows[y])
    item = ITEM.match(plain)
    if item and item.start(1) <= x < item.end(1):
        return item[1]
    m = CHOICES.match(plain)
    if m:
        letters = m.start(2)
        for i, c in enumerate(m[2]):
            if c.strip() and letters + i == x:
                return m[1] + c
    return next((m[0] for m in SHORTHAND.finditer(plain) if m.start() <= x < m.end()), None)


def screen(pane, ansi=False):
    """The rows a pane shows now: scrolled back (copy mode), the ones scrolled to."""
    up, height = (tmux("display", "-p", "-t", pane, "#{scroll_position}x#{pane_height}") or "x0").split("x")
    up = int(up or 0)
    at = ["-S", str(-up), "-E", str(int(height) - 1 - up)] if up else []
    # not tmux(): it strips, and the blank rows on top went with it (every row after them one too high)
    r = subprocess.run(["tmux", "-L", SOCKET, "capture-pane", "-p", *(["-e"] if ansi else []), *at, "-t", pane],
                       capture_output=True, text=True)
    return r.stdout.removesuffix("\n").split("\n") if r.returncode == 0 else []


def commit_in(sha, repos):
    """The repo (of the first that has it) where sha names a commit."""
    for repo in dict.fromkeys(filter(None, repos)):
        if os.path.isdir(repo) and not subprocess.run(["git", "-C", repo, "cat-file", "-e", f"{sha}^{{commit}}"],
                                                      capture_output=True).returncode:
            return repo
    return None


def show_commit(zid, repo, sha):
