EMPTY_TREE = "4b825dc642cb6eb9a060e54bf8d69288fbee4904"  # git's id of no files: the base before a first commit


def changes(path=None):
    """What changed in the working tree since the last commit, new files included, as one diff
    (of one file: path)."""
    git = lambda *a: subprocess.run(["git", *a], capture_output=True).stdout
    base = "HEAD" if git("rev-parse", "-q", "--verify", "HEAD") else EMPTY_TREE
    out = git("diff", base, "--", *([path] if path else []))
    new = git("ls-files", "--others", "--exclude-standard", "-z", "--", *([path] if path else []))
    for f in filter(None, new.split(b"\0")):
        out += git("diff", "--no-index", "--", "/dev/null", f.decode())
    return out


# ── changed files ──────────────────────────────────────────────────────────
# git status is not polled: macOS FSEvents (through ctypes, nothing to install) tells when a file in
# the repository changed, and only then does it run again, at most every CHANGES_MIN_S seconds, in the
# shown sidebar. Its list is shared through CHANGES_DIR, so sidebars of one repository run it once.

CHANGES_DIR = f"{HOME}/changes"
CHANGES_MIN_S = 5
CHANGES_POLL_S = 60  # without FSEvents
CHANGES_SHOWN = 10   # changed files listed under the changes tab, the last changed first (its count is all of them)
_changed = {}     # repository top -> (when its git status started, its files)
_changed_at = {}  # repository top -> when a file in it last changed (seen by this process)
_streams = {}     # repository top -> its FSEvents stream and callback (kept alive), or None
_unwatched = []   # the callbacks of stopped streams: kept alive, one may still be running
_tops = {}        # folder -> (when asked, its repository top or None)
_fsevents = None


def repo_top(cwd):
    hit = _tops.get(cwd)
    if hit and (hit[1] or time.time() - hit[0] < CHANGES_POLL_S):  # a folder may become a repository
        return hit[1]
    top = subprocess.run(["git", "-C", cwd, "rev-parse", "--show-toplevel"],
                         capture_output=True, text=True).stdout.strip() or None
    _tops[cwd] = (time.time(), top)
    return top


def changed_path(cwd, path):
    """The full path of a file git status lists (relative to the repository's top)."""
    return os.path.join(repo_top(cwd) or cwd, path)


def fsevents():
    """CoreServices' FSEvents through ctypes; False where it cannot load."""
    global _fsevents
    if _fsevents is None:
        try:
            import ctypes
            V, P = ctypes.c_void_p, ctypes.POINTER
            cf = ctypes.CDLL("/System/Library/Frameworks/CoreFoundation.framework/CoreFoundation")
            cs = ctypes.CDLL("/System/Library/Frameworks/CoreServices.framework/CoreServices")
            libc = ctypes.CDLL("/usr/lib/libSystem.B.dylib")
            cf.CFStringCreateWithCString.restype, cf.CFStringCreateWithCString.argtypes = V, [V, ctypes.c_char_p, ctypes.c_uint32]
            cf.CFArrayCreate.restype, cf.CFArrayCreate.argtypes = V, [V, P(V), ctypes.c_long, V]
            callback = ctypes.CFUNCTYPE(None, V, V, ctypes.c_size_t, P(ctypes.c_char_p), V, V)
            cs.FSEventStreamCreate.restype = V
            cs.FSEventStreamCreate.argtypes = [V, callback, V, V, ctypes.c_uint64, ctypes.c_double, ctypes.c_uint32]
            cs.FSEventStreamSetDispatchQueue.argtypes = [V, V]
            cs.FSEventStreamStart.restype, cs.FSEventStreamStart.argtypes = ctypes.c_bool, [V]
            for name in ("FSEventStreamStop", "FSEventStreamInvalidate", "FSEventStreamRelease"):
                getattr(cs, name).argtypes = [V]
            libc.dispatch_queue_create.restype, libc.dispatch_queue_create.argtypes = V, [ctypes.c_char_p, V]
            _fsevents = (ctypes, cf, cs, callback, libc.dispatch_queue_create(b"zidev.changes", None))
        except Exception:
            log(traceback.format_exc())
            _fsevents = False
    return _fsevents


def counts(path):
    """A change git status can show: anything outside .git; inside it only what a commit, an add or a
    checkout writes, not git's own bookkeeping (fsmonitor cookies, logs, locks)."""
    _, inside, rest = path.partition("/.git/")
    return not inside or rest in ("index", "HEAD", "packed-refs") or rest.startswith("refs/")


def watch(top):
    """Watch a repository from now on (once per process); False when it cannot be watched."""
    if top in _streams:
        return _streams[top] is not None
    _changed_at[top] = time.time()  # what changed before is unknown
    _streams[top] = None
    fs = fsevents()
    if not fs:
        return False
    ctypes, cf, cs, callback, queue = fs

    def seen(_stream, _info, n, paths, _flags, _ids):
        if any(counts(paths[i].decode(errors="replace")) for i in range(n)):
            _changed_at[top] = time.time()

    keep = callback(seen)
    name = cf.CFStringCreateWithCString(None, top.encode(), 0x08000100)  # UTF-8
    paths = cf.CFArrayCreate(None, (ctypes.c_void_p * 1)(name), 1,
                             ctypes.addressof(ctypes.c_void_p.in_dll(cf, "kCFTypeArrayCallBacks")))
    # since now, 1 s latency (events coalesce), file-level events
    stream = cs.FSEventStreamCreate(None, keep, None, paths, 0xFFFFFFFFFFFFFFFF, 1.0, 0x10)
    if not stream:
        return False
    cs.FSEventStreamSetDispatchQueue(stream, queue)
    if not cs.FSEventStreamStart(stream):
        return False
    _streams[top] = (stream, keep)
    return True


def unwatch(top):
    """Stop watching a repository the sidebar does not list any more (its project archived, removed or folded)."""
    stream = _streams.pop(top, None)
    _changed_at.pop(top, None)
    _changed.pop(top, None)
    if stream:
        cs = fsevents()[2]
        cs.FSEventStreamStop(stream[0])
        cs.FSEventStreamInvalidate(stream[0])
        cs.FSEventStreamRelease(stream[0])
        _unwatched.append(stream[1])


def changed_files(cwd, run=True):
    """(status letter, path) of a repository's changed files, listed under its changes tab. git status
    runs again only after a file in it changed; run=False never runs it (a hidden sidebar)."""
    top = repo_top(cwd)
    if not top:
        return []
    now = time.time()
    since = _changed_at[top] if watch(top) else now - CHANGES_POLL_S
    hit = _changed.get(top)
    if hit and (hit[0] >= since or now - hit[0] < CHANGES_MIN_S):
        return hit[1]
    path = f"{CHANGES_DIR}/{top.strip('/').replace('/', '%')}.json"
    stale = lambda d: d.get("at", 0) < since or "commits" not in d
    shared = read_json(path, {})
    if stale(shared) and run:
        os.makedirs(CHANGES_DIR, exist_ok=True)
        with open(f"{path}.lock", "w") as lock:  # one sidebar runs it, the others take its list
            fcntl.flock(lock, fcntl.LOCK_EX)
            shared = read_json(path, {})
            if stale(shared):
                shared = {"at": time.time(), "files": newest_first(top, git_changes(top)), "commits": git_commits(top)}
                write_json(path, shared)
    if "files" not in shared:
        return hit[1] if hit else []
    _changed[top] = (shared["at"], [tuple(f) for f in shared["files"]], [tuple(c) for c in shared.get("commits", [])])
    return _changed[top][1]


def newest_first(top, files):
    """The last changed first: the sidebar lists CHANGES_SHOWN of them."""
    def changed_at(f):
        try:
            return os.lstat(os.path.join(top, f[1])).st_mtime
        except OSError:  # deleted
            return 0
    return sorted(files, key=changed_at, reverse=True)


COMMITS_SHOWN = 5


def recent_commits(cwd):
    """(short hash, subject) of the last commits, read with the changed files (changed_files first)."""
    hit = _changed.get(repo_top(cwd) or "")
    return hit[2] if hit else []


def git_commits(top):
    out = subprocess.run(["git", "--no-optional-locks", "-C", top, "log", f"-{COMMITS_SHOWN}", "--format=%h%x09%s"],
                         capture_output=True, text=True).stdout
    return [l.split("\t", 1) for l in out.splitlines() if "\t" in l]


def git_changes(top):
    # --no-optional-locks: status never writes the index, so it does not wake its own watch
    r = subprocess.run(["git", "--no-optional-locks", "-C", top, "status", "--porcelain=v1", "-z", "-uall"],
                       capture_output=True, text=True)
    parts, files = (r.stdout.split("\0") if r.returncode == 0 else []), []
    while parts:
        entry = parts.pop(0)
        if len(entry) < 4:
            continue
        xy, path = entry[:2], entry[3:]
        if xy[0] in "RC":  # the old name follows
            parts = parts[1:]
        files.append(("?" if xy == "??" else xy[1] if xy[1] != " " else xy[0], path))
    return files[:200]


def cmd_git(where, file=""):
    """Pane process of the changes tab: the diff of one changed file (delta, n / N next / previous
    change), the one picked under it in the sidebar, else the first; scrolling never runs on into
    another file. esc closes the tab. It is redrawn each time it is shown."""
    if subprocess.run(["git", "rev-parse", "--git-dir"], capture_output=True).returncode:
        diff, msg = b"", "not a git repository"
    elif file.startswith("commit:"):  # one of the last commits listed under the changes
        diff = subprocess.run(["git", "show", "--stat", "-p", file[7:]], capture_output=True).stdout
        msg = f"no commit {file[7:]}"
    else:
        files = [f for _, f in git_changes(repo_top(os.getcwd()))]  # shown now: fresh, not the watched list
        file = file if file in files else files[0] if files else ""
        if os.environ.get("TMUX_PANE"):  # the sidebar marks the file shown
            tmux("set", "-p", "-t", os.environ["TMUX_PANE"], "@zidev_file", file)
        diff = changes(file or None)
        msg = "" if diff else f"no changes in {file}" if file else "no changes since the last commit"
    if diff:
        numbers, top, rows, origin = False, None, [], []

        def page():  # delta at the pane's width; our less keeps delta's n / N between files and hunks
            width = columns()
            shown = subprocess.run(["delta", "--dark", f"--syntax-theme={THEME['bat']}", "--paging=never",
                                    "--navigate", *(["--line-numbers"] if numbers else []), f"--width={width}",
                                    "--hunk-header-decoration-style=none"],
                                   input=diff, capture_output=True).stdout.decode(errors="replace")
            rows[:], origin[:] = [], []  # screen rows, and the diff line each one comes from
            for i, l in enumerate(shown.split("\n")):
                for r in wrap_ansi(l, width).split("\n"):
                    rows.append(r)
                    origin.append(i)
            at = [f"+{origin.index(top) + 1}g", "-j1"] if top is not None and top in origin else \
                ["-p", "^(commit|added:|copied:|Δ|removed:|renamed:|•)"]
            prompt = re.sub(r"([%?:.\\])", r"\\\1", f"{file}   esc close  ⏎ open file  n / N next / previous change  l lines  /search")
            return pager("\n".join(rows).encode(), ["-X", *at, f"-Ps{prompt}"],
                         {**os.environ, "LESSKEY_CONTENT": LESSKEYS + "#command\nl quit l\n\\n quit o\n"})
        while (status := until_resized(page)) in (108, 111):
            top = origin[top_line(rows) - 1]  # staying where you are
            if status == 108:  # l: line numbers on / off
                numbers = not numbers
                continue
            path, zid = changed_path(os.getcwd(), file), zid_of_pane(os.environ.get("TMUX_PANE"))
            if zid and os.path.isfile(path):  # ⏎: the file itself, as a tab
                new_tab(zid, "file", file=path)
    else:
        print(f"\n  \033[2m{msg}\n\n  esc closes\033[0m")
        with contextlib.suppress(Exception):
            import termios
            import tty
            fd, old = sys.stdin.fileno(), termios.tcgetattr(sys.stdin.fileno())
            try:
                tty.setcbreak(fd)
                while sys.stdin.read(1) not in ("\x1b", ""):
                    pass
            finally:
                termios.tcsetattr(fd, termios.TCSADRAIN, old)
    leave_tab()


