def port_open(port):
    import socket
    with socket.socket() as so:
        so.settimeout(0.2)
        return so.connect_ex(("127.0.0.1", port)) == 0


def serve(path):
    """URL of an html file on a local http server for its folder (started once, then reused)."""
    import socket
    import urllib.parse
    folder = os.path.dirname(path)
    try:
        servers = json.load(open(SERVERS))
    except (OSError, ValueError):
        servers = {}
    port = servers.get(folder)
    if not (port and port_open(port)):
        with socket.socket() as so:
            so.bind(("127.0.0.1", 0))
            port = so.getsockname()[1]
        # it works in the folder: archiving its project stops it
        subprocess.Popen([sys.executable, "-m", "http.server", str(port), "--bind", "127.0.0.1",
                          "--directory", folder], cwd=folder, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                         stderr=subprocess.DEVNULL, start_new_session=True)
        for _ in range(50):
            if port_open(port):
                break
            time.sleep(0.05)
        servers[folder] = port
        with open(SERVERS, "w") as f:
            json.dump(servers, f)
    return f"http://127.0.0.1:{port}/" + urllib.parse.quote(os.path.basename(path))


