            with edit_state() as d:  # sent once: a restart must not repeat it
                for x in d["sessions"]:
                    if x["id"] == zid:
                        x.pop("prompt", None)
        try:
            subprocess.call(args, cwd=s["cwd"])
        except OSError as e:
            print(f"\033[31mcan't start Claude: {e}\033[0m  (is `claude` on PATH? zidev doctor checks)")
        set_status(zid, "exited")
        print("\n\033[2mClaude exited.  \033[0m[enter] restart   [x] close session\n")
