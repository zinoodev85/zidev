def cmd_apptest():
    """spec.md, the app rows: drives the running zidev.app through its probe (notifyutil -p zidev.probe) on a
    throwaway window of this server: real cmd-clicks on cells, cmd-cmd fed to its double-tap detector."""
    failed = []

    def check(name, good):
        print(f"  {'\033[32mok' if good else '\033[31mFAIL'}\033[0m  {name}")
        if not good:
            failed.append(name)

    def probe(click=None, keys=None, plain=False, press=None, paste=None):
        if press:  # a key press ("cmd-k") through the app's key map, as from the keyboard
            with open(f"{HOME}/probe-press", "w") as f:
                f.write(press)
        if paste:
            with open(f"{HOME}/probe-paste", "w") as f:
                f.write(paste)
        if click:
            with open(f"{HOME}/probe-click", "w") as f:
                f.write(f"{click[0]} {click[1]}{' plain' if plain else ''}")
        if keys:
            with open(f"{HOME}/probe-keys", "w") as f:
                f.write(keys)
        with contextlib.suppress(FileNotFoundError):
            os.remove(f"{HOME}/probe-screen.txt")
        subprocess.run(["notifyutil", "-p", "zidev.probe"])
        end = time.time() + 3
        while time.time() < end and not os.path.exists(f"{HOME}/probe-screen.txt"):
            time.sleep(0.05)
        time.sleep(0.3)  # the click's zidev call, the toggle
        with contextlib.suppress(FileNotFoundError):
            return open(f"{HOME}/probe-screen.txt").read()
        return ""

    client = (tmux("list-clients", "-F", "#{client_name} #{client_termtype}") or "").split("\n")
    client = next((c.split(" ")[0] for c in client if "SwiftTerm" in c), None)
