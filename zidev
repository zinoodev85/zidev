    """fzf action: what fzf marks in the palette's rows (they come already found): what is typed, of file:line its
    file; nothing in the Text tab (ripgrep marks it there) or for >cmd."""
    return ("transform-search~"
            f"[ \"$(cat {work}/tab)\" = Text ] || case {{q}} in '>'*) ;; *) printf %s {{q}} | sed -E 's/^(.+):[0-9]+$/\\1/' ;; esac~")


def cmd_palette_rows(work, folder, query):
    """The palette's rows for its tab and what is typed, best first (fzf shows them as they are).
    folder: the project's, or "" when the palette is not in one of its sessions."""
    with open(f"{work}/tab") as f:
        tab = f.read()
    if tab == "Text":
        rows = text_rows(folder, query)
    elif tab == "Clipboard":
        rows = fuzzy(clip_rows(), query)
    elif tab == "All" and not query:
        rows = open(f"{work}/empty").read().splitlines()
    elif query.startswith(">"):  # a shell command: runs in a terminal tab
        cmd = query[1:].strip()
        rows = [f"run\t\033[32m▶\033[0m {cmd}\t.\t{cmd}"] if cmd and folder else []
    else:
        while not os.path.exists(f"{work}/full"):  # the scripts and files are still being listed
            time.sleep(0.05)
        rows = open(f"{work}/full").read().splitlines()
        at = re.fullmatch(r"(.+):(\d+)", query)
        if at:  # file:line: the files with that name, opened at the line
            rows = [r + at[2] for r in fuzzy([r for r in rows if r.startswith("file\t")], at[1])]
        else:
            rows = fuzzy([r for r in rows if tab == "All" or r.split("\t")[0] in PALETTE_TAB_KINDS[tab]], query)
            if tab == "All":  # at most the 3 best apps; the rest are in the Apps tab
                more_apps = set([r for r in rows if r.startswith("app\t")][3:])
                rows = [r for r in rows if r not in more_apps]
    if query and tab == "All":  # always last: search the web for it
        rows.append(f"google\t\033[34mG\033[0m Google: {query}\t{query}\t")
    sys.stdout.write("".join(f"{r}\n" for r in rows))


def fuzzy(rows, query):
    """The palette rows whose shown text matches query, best first: fzf's own search (fzf --filter)."""
    if not query:
        return rows
    shown = [ANSI.sub("", r.split("\t")[1]) for r in rows]  # without colours
    found = subprocess.run(["fzf", f"--filter={query}", "--delimiter=\t", "--with-nth=2", "--tiebreak=index"],
                           input="".join(f"{i}\t{x}\n" for i, x in enumerate(shown)), capture_output=True, text=True)
    return [rows[int(x.split("\t")[0])] for x in found.stdout.splitlines()]


def text_rows(folder, query):
    """The Text tab: the lines in the project's files that have query (ripgrep), at most 500."""
    if not (folder and query):
        return []
    rg = subprocess.Popen(["rg", "--line-number", "--no-heading", "--color=always", "--colors=path:none",
                           "--colors=line:none", "--field-match-separator=\t", "--smart-case", "--hidden",
                           "-g", "!.git", "--max-columns=300", "--max-columns-preview", "--", query],
                          cwd=folder, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True,
                          errors="replace")
    rows = []
    for line in rg.stdout:  # path, line number and the line, the match in colour
        path, n, text = line.rstrip("\n").split("\t", 2)
        path, n, text = ANSI.sub("", path), ANSI.sub("", n), text.strip().replace("\t", "  ")
        rows.append(f"text\t{text}  {dim(f'{path}:{n}')}\t{path}\t{n}")
        if len(rows) == 500:
            break
    rg.kill()
    return rows


def clip_rows():
    """The Clipboard tab: the copies zidev.app keeps, newest first, each on one line."""
    today = time.strftime("%d.%m.")
    rows = []
    for c in read_json(f"{CLIPS}/index.json", []):
        when = time.strftime("%d.%m. %H:%M", time.localtime(c["t"])).removeprefix(today + " ")  # today: the time only
        line = " ".join(c["text"].split())[:300]
        rows.append(f"clip\t\033[33m⧉\033[0m {line}  {dim(c['app'] + ' · ' + when)}\t{c['id']}\t")
    return rows


def clip_text(cid):
    """A copy's plain text; None when it has none (an image)."""
    with contextlib.suppress(OSError, ValueError, plistlib.InvalidFileException), open(f"{CLIPS}/{cid}.plist", "rb") as f:
        for kept in plistlib.load(f)[0]:  # its first item: {type, data} for each of its types
            if kept["type"] == "public.utf8-plain-text":
                return kept["data"].decode(errors="replace")
    return None


