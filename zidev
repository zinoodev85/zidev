def cmd_hook():
    """Claude Code hook: record the session's status. Must stay fast and silent."""
    zid = os.environ.get("ZIDEV_ID")
    if not zid:
        return
    try:
        ev = json.load(sys.stdin)
    except ValueError:
        return
    os.makedirs(STATUS_DIR, exist_ok=True)
    name = ev.get("hook_event_name")
    tool = ev.get("tool_name", "")
    state = detail = None
    if name == "SessionStart":
        state = "idle"
    elif name == "UserPromptSubmit":
        state = "working"
    elif name == "PreToolUse":
        state, detail = ("waiting", ASKING_TOOLS[tool]) if tool in ASKING_TOOLS else ("working", "")
    elif name == "PostToolUse":
        state = "working"
    elif name == "PermissionRequest":
        state, detail = "waiting", ASKING_TOOLS.get(tool) or (f"allow {tool}?" if tool else "needs permission")
    elif name == "Notification":
        kind = ev.get("notification_type", "")
        msg = ev.get("message", "")
        if kind in ("permission_prompt", "elicitation_dialog") or (not kind and "permission" in msg.lower()):
            state, detail = "waiting", msg
    elif name == "Stop":
        state = "done"
    elif name == "StopFailure":
        state, detail = "error", str(ev.get("error") or ev.get("message") or "failed")
    elif name == "SessionEnd":
        state = "exited"

    path = f"{STATUS_DIR}/{zid}.json"
    st = read_json(path, {})
    if ev.get("session_id"):
        st["claude_id"] = ev["session_id"]  # changes on /clear; resume must follow it
    if ev.get("transcript_path"):  # Claude's names for the session are in there
        st["transcript"] = ev["transcript_path"]
    if name == "UserPromptSubmit" and not st.get("prompt"):
        st["prompt"] = " ".join(str(ev.get("prompt", "")).split())[:80]
    if state:
        if state != st.get("state"):
            st["since"] = time.time()
            if state in ("waiting", "done", "error"):
                notify(zid, st, state, detail)
        st["state"], st["detail"] = state, detail or ""
    write_json(path, st)


def notify(zid, st, state, detail):
    """macOS notification, unless that session is on screen."""
    # ZIDEV_NOTIFY=0: the host shows its own notifications (the Neovim Claude panel does)
    if os.environ.get("ZIDEV_NOTIFY") == "0" or not read_json(CONFIG, {}).get("notify", True):
        return
    on_screen = tmux("display", "-p", "-t", os.environ.get("TMUX_PANE", ""),
                     "#{&&:#{window_active},#{session_attached}}")
    if on_screen == "1":
        return
    s = next((s for s in load_state()["sessions"] if s["id"] == zid), {"cwd": "", "title": ""})
    body = {"waiting": detail or "needs your input", "done": "finished", "error": detail}[state]
    title = f"{project_name(s['cwd'])} · {title_of(s, st)}"
    if os.environ.get("ZIDEV_NOTIFY") == "log":  # the selftest reads them
        with open(f"{HOME}/notifications", "a") as f:
            f.write(f"{title}\t{body}\n")
        return
    script = f"display notification {json.dumps(body)} with title {json.dumps(title)}"
    subprocess.Popen(["osascript", "-e", script], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


_titles = {}  # transcript -> (bytes read, /rename name, Claude's own title)


def claude_titles(path):
    """The session's names in Claude Code, from its transcript: (/rename name, Claude's own title).
    Reads on from where it stopped last time (the sidebar asks on every draw)."""
    try:
        size = os.path.getsize(path) if path else 0
    except OSError:
        size = 0
    at, custom, ai = _titles.get(path, (0, None, None))
    if size < at:
        at, custom, ai = 0, None, None
    if size > at:
        with open(path, "rb") as f:
            f.seek(at)
            chunk = f.read(size - at)
        end = chunk.rfind(b"\n") + 1  # a line still being written: next time
        for line in chunk[:end].split(b"\n"):
            if b'"custom-title"' in line or b'"ai-title"' in line:
                with contextlib.suppress(ValueError, AttributeError):
                    e = json.loads(line)
                    custom = e.get("customTitle") or custom if e.get("type") == "custom-title" else custom
                    ai = e.get("aiTitle") or ai if e.get("type") == "ai-title" else ai
        _titles[path] = (at + end, custom, ai)
    return custom, ai


def title_of(s, st):
    """The name r gave it, until a /rename in Claude after that; else Claude's names, else the first prompt."""
    custom, ai = claude_titles(st.get("transcript"))
    if s.get("title") and custom == s.get("title_over"):
        return s["title"]
    return custom or ai or s.get("title") or st.get("prompt") or "new session"


# ── sidebar ────────────────────────────────────────────────────────────────

SPIN = "⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏"


def age(ts):
    if not ts:
        return ""
    s = int(time.time() - ts)
    for unit, n in (("d", 86400), ("h", 3600), ("m", 60)):
        if s >= n:
            return f"{s // n}{unit}"
    return f"{s}s"


class Sidebar:
    def __init__(self, scr, message=""):
        self.scr = scr
        self.pane = os.environ.get("TMUX_PANE", "")
        self.my_id = tmux("display", "-p", "-t", self.pane, "#{@zidev_id}") or ""
        self.items = []    # ("project", cwd) | ("session", session dict) | ("tab", tab dict)
        self.cursor = 0
        self.top = 0
        self.max_top = 0  # the last line can't go higher than the bottom
        self.theme = None  # "light" / "dark" once the selection bar is painted for it (256 colors)
        self.pick_at = None  # the pick list the cursor was put on
        self.scrolled = False  # the wheel moved the list: the cursor may be off screen
        self.view_seen = None
        self.rows = {}     # screen y -> item index
        self.visible = False
        self.win_w = 0  # window width at the last size check: same width, other sidebar width = a drag
        self.focused = False
        self.frame = 0
        self.message = message
        self.help = False
        self.filter = ""
        self.footer = []   # (y, x from, x to, key) of the clickable footer hints
        self.term_seen = {}  # pane -> (its last rows, since when): a script that stopped on a question
        self.waits = set()   # panes of terminal tabs that wait for you

    # data

    def load(self):
        self.data = load_state()
        self.status = {s["id"]: read_status(s["id"]) for s in self.data["sessions"]}
        # tmux did not answer: keep what was there, the sessions did not stop
        wins, tabs = session_windows(strict=True), all_tabs(strict=True)
        self.windows = wins if wins is not None else getattr(self, "windows", {})
        self.tabs = tabs if tabs is not None else getattr(self, "tabs", [])
        gone = set(self.data.get("archived", []))  # archived: not listed (A finds them)
        self.data["projects"] = [c for c in self.data["projects"] if c not in gone]
        self.data["sessions"] = [s for s in self.data["sessions"] if s["cwd"] not in gone]
        key = self.ident(self.items[self.cursor]) if self.items else None
        by_cwd = {}
        for s in self.data["sessions"]:
            if self.matches(s):
                by_cwd.setdefault(s["cwd"], []).append(s)
        projects = self.data["projects"] + [c for c in by_cwd if c not in self.data["projects"]]
        self.items, self.changes = [], {}  # changes: project -> its changed files
        pick = self.data.get("pick")
        if pick and pick["zid"] == self.my_id:  # a name several files have: pick one (guess first)
            files = sorted(pick["files"], key=lambda f: f != pick["guess"])
            self.items += [("pick", pick)] + [("pickfile", f) for f in files]
            if pick["more"]:
                self.items.append(("pickmore", pick))
            if pick["at"] != self.pick_at:  # new: the cursor on its first file
                self.pick_at, key, self.scrolled = pick["at"], ("pickfile", files[0]), False
        for cwd in projects:
            if self.filter and cwd not in by_cwd:
                continue
            self.items.append(("project", cwd))
            if cwd not in self.data["collapsed"] or self.filter:
                self.items += [("session", s) for s in by_cwd.get(cwd, [])]  # a session is its Claude
                for t in project_tabs(cwd, self.tabs):  # shared by its sessions
                    self.items.append(("tab", t))
                    if t["kind"] == "git":  # its changed files under it, when unfolded
                        self.changes[cwd] = changed_files(cwd)
                        if cwd in self.data["changes_open"]:
                            self.items += [("change", (t, st, path)) for st, path in self.changes[cwd]]
        self.waits = {t["pane"] for t in self.tabs if self.term_waits(t)}
        self.select(key)

    ASKS = re.compile(r"([?:\])›])\s*$|\b(y/n|yes/no|password|passphrase|press (any key|enter|return))\b", re.I)

    def term_waits(self, t):
        """A terminal tab running something (not its shell) that went still on a question: it needs you."""
        if t["kind"] != "term" or t["cmd"] in SHELLS:
            self.term_seen.pop(t["pane"], None)
            return False
        rows = [r for r in (tmux("capture-pane", "-p", "-t", t["pane"]) or "").split("\n") if r.strip()]
        last = rows[-1] if rows else ""
        seen = self.term_seen.get(t["pane"])
        if not seen or seen[0] != rows[-3:]:
            self.term_seen[t["pane"]] = (rows[-3:], time.time())
            return False
        return time.time() - seen[1] >= 2 and bool(self.ASKS.search(last))

    def save_view(self):
        """Cursor and scroll for every window's sidebar: switching windows shows the same list."""
        if self.items:
            self.view_seen = {"top": self.top, "item": json.dumps(self.ident(self.current())),
                              "scrolled": self.scrolled}
            write_json(VIEW, self.view_seen)

    def adopt_view(self):
        v = read_json(VIEW, {})
        if not v or v == self.view_seen:
            return
        self.view_seen, self.top, self.scrolled = v, v.get("top", 0), v.get("scrolled", False)
        at = next((i for i, item in enumerate(self.items) if json.dumps(self.ident(item)) == v.get("item")), None)
        me = next((s for s in self.data["sessions"] if s["id"] == self.my_id), None)
        if at is not None and me and self.is_mine(self.items[at], me):  # else about another window
            self.cursor = at

    def is_mine(self, item, me):
        """A row about this window: its session, or its project and the project's tabs."""
        kind, v = item
        if kind == "session":
            return v["id"] == me["id"]
        return kind.startswith("pick") or self.project_of(kind, v) == me["cwd"]

    @staticmethod
    def ident(item):
        kind, v = item
        return kind, (v if kind in ("project", "pickfile") else v["id"] if kind == "session" else
                      v["at"] if kind in ("pick", "pickmore") else
                      (v[0]["pane"], v[2]) if kind == "change" else v["pane"])

    def session_of_item(self, kind, v):
        """The session a row's t / g / c open in: its own; a project or tab row: here()."""
        return v if kind == "session" else self.here(self.project_of(kind, v)) if kind and "pick" not in kind else None

    @staticmethod
    def project_of(kind, v):
        return {"project": lambda: v, "session": lambda: v["cwd"], "tab": lambda: v["project"],
                "change": lambda: v[0]["project"]}[kind]()

    def here(self, cwd):
        """Where a project's tab shows: this window when it is the project's, else its window used last."""
        me = next((s for s in self.data["sessions"] if s["id"] == self.my_id), None)
        zid = self.my_id if me and me["cwd"] == cwd else last_session(cwd, self.tabs, self.windows)
        return next((s for s in self.data["sessions"] if s["id"] == zid), None)

    def matches(self, s):
        words = self.filter.lower().split()
        text = f"{title_of(s, self.status.get(s['id'], {}))} {project_name(s['cwd'])}".lower()
        return all(w in text for w in words)

    def select(self, key):
        for i, item in enumerate(self.items):
            if key == self.ident(item):
                self.cursor = i
                return
        self.cursor = min(self.cursor, max(len(self.items) - 1, 0))

    def current(self):
        return self.items[self.cursor] if self.items else (None, None)

    def state_of(self, s):
        """(state, needs attention) of a session."""
        st = self.status.get(s["id"], {})
        state = st.get("state", "idle")
        if s["id"] not in self.windows:
            state = "stopped"
        unseen = st.get("since", 0) > seen_at(s["id"]) and s["id"] != self.my_id
        return state, state == "waiting" or (state in ("done", "error") and unseen)

    # drawing

    def put(self, y, x, text, attr=0):
        h, w = self.scr.getmaxyx()
        if attr & curses.A_REVERSE and self.theme:  # the selected row: a quiet gray bar, colors kept
            pair = (SEL_PAIR if self.focused else 2 * SEL_PAIR) + curses.pair_number(attr)
            attr = attr & ~(curses.A_REVERSE | curses.A_COLOR) | curses.color_pair(pair)
        if 0 <= y < h and x < w:
            with contextlib.suppress(curses.error):
                self.scr.addnstr(y, x, text, w - x, attr)

    def draw(self):
        self.scr.erase()
        h, w = self.scr.getmaxyx()
        if self.help:
            return self.draw_help(h, w)
        dim, bold = curses.A_DIM, curses.A_BOLD
        c = lambda n: curses.color_pair(n)

        need = sum(1 for k, v in self.items if k == "session" and self.state_of(v)[1]) + len(self.waits)
        self.put(0, 1, "zidev", bold)
        if need:
            label = f"{need} need you"
            self.put(0, w - len(label) - 1, label, c(3) | bold)

        lines = []  # (item index, draw fn)
        for i, (kind, v) in enumerate(self.items):
            lines.append((i, kind, v, 0))
            if kind == "session":
                st = self.status.get(v["id"], {})
                if self.state_of(v)[0] in ("waiting", "error") and st.get("detail"):
                    lines.append((i, "detail", f"{st['detail']} · {age(st.get('since'))}", 1))

        body_top, body_h = 2, max(h - 4, 1)
        cur_line = next((n for n, l in enumerate(lines) if l[0] == self.cursor), 0)
        if self.scrolled:
            pass
        elif cur_line < self.top:
            self.top = cur_line
        elif cur_line >= self.top + body_h:
            self.top = cur_line - body_h + 1
        self.max_top = max(0, len(lines) - body_h)
        self.top = max(0, min(self.top, self.max_top))
        self.rows = {}
        for n, (i, kind, v, _) in enumerate(lines[self.top:self.top + body_h]):
            y = body_top + n
            self.rows[y] = i
            sel = i == self.cursor  # always shown; dimmer while the focus is elsewhere
            base = curses.A_REVERSE | (0 if self.focused or self.theme else curses.A_DIM) if sel else 0
            if sel:
                self.put(y, 0, " " * w, base)
            if kind == "project":
                folded = v in self.data["collapsed"]
                self.put(y, 1, ("▸ " if folded else "▾ ") + project_name(v), base | bold)
                sessions = [s for s in self.data["sessions"] if s["cwd"] == v]
                waiting = sum(1 for s in sessions if self.state_of(s)[1]) + \
                    sum(1 for t in self.tabs if t["pane"] in self.waits and t["project"] == v)
                # folded: what is inside still shows, ● while one of its sessions needs you, else a spinner
                # while one works
                states = {self.state_of(s)[0] for s in sessions} if folded else set()
                mark = ("●", c(3) | bold) if "waiting" in states else \
                    (SPIN[self.frame % len(SPIN)], c(4)) if "working" in states else None
                if mark:
                    self.put(y, w - 2, mark[0], base | mark[1])
                if folded and waiting:
                    self.put(y, w - (5 if mark else 3), f"{waiting} ", base | c(3) | bold)
            elif kind == "session":
                self.draw_session(y, w, v, base)
            elif kind == "tab":
                self.draw_tab(y, w, v, base)
            elif kind == "change":
                self.draw_change(y, w, v, base)
            elif kind == "pick":
                self.put(y, 1, f"which {v['name']}?"[: w - 2], base | c(3) | bold)
                if v["asking"]:
                    self.put(y, w - 8, "asking…", base | dim)
            elif kind == "pickfile":
                pick = self.data["pick"]
                cwd = (session_of(pick["zid"]) or {}).get("cwd", "/")
                name = os.path.relpath(v, cwd) if v.startswith(cwd + "/") else v.replace(os.path.expanduser("~"), "~", 1)
                name = name if len(name) <= w - 5 else "…" + name[-(w - 6):]
                self.put(y, 1, ("✦ " if v == pick["guess"] else "  ") + name, base | (bold if v == pick["guess"] else 0))
            elif kind == "pickmore":
                self.put(y, 3, f"… {v['more']} more", base | dim)
            else:
                self.put(y, 5, v[: w - 6], base | c(3) | dim)

        if not self.items:
            self.put(body_top, 1, "no match — esc clears the filter" if self.filter
                     else "no sessions — n: new session", dim)
        self.draw_footer(h, w)
        self.scr.refresh()

    FOOTER = ([("⏎ open", 10), ("n new", "n"), ("t term", "t"), ("c cmds", "c")],
              [("w next", "w"), ("/ find", "/"), ("? keys", "?"), ("x close", "x")])

    def draw_footer(self, h, w):
        self.footer = []
        rows = list(self.FOOTER)
        if self.filter:
            rows[0] = [(f"/{self.filter}", "/"), ("esc clear", 27)]
        for y, row in zip((h - 2, h - 1), rows):
            x = 1
            for label, key in row:
                self.put(y, x, label, curses.A_DIM if not self.filter or y == h - 1 else curses.A_BOLD)
                self.footer.append((y, x, x + len(label), key))
                x += len(label) + 2
        if self.message:
            self.put(h - 2, 0, " " * w)
            self.put(h - 2, 1, self.message[: w - 2], curses.color_pair(3))

    HELP = [("⏎ / click", "show session (Claude) / tab; a project: its first session"),
            ("space / ▸", "fold / unfold project or changes"), ("wheel", "scrolls the list"), ("right click", "menu: close, rename, …"), ("n", "new session in project"),
            ("p", "new project (folder)"), ("r", "rename session / project"), ("x", "close session / tab"),
            ("R", "restart Claude"), ("J / K", "move session down / up"), ("t", "terminal tab"),
            ("g", "changes tab: diff (n / N file)"), ("c", "commands tab: run, open, grep"), ("w", "next that needs you"),
            ("/", "filter sessions"), ("esc", "clear filter"), ("h / ←", "go up: session, project"),
            ("a", "archive project"), ("A", "archived: search, unarchive"),
            ("ctrl-q", "menu (again: sidebar ⇄ tab)"), ("cmd-b", "hide / show the sidebar"),
            ("cmd-↑ / ↓", "item above / below"), ("cmd-t", "terminal next to Claude"), ("", ""),
            ("", "any key closes this")]

    def draw_help(self, h, w):
        self.put(0, 1, "zidev keys", curses.A_BOLD)
        for y, (k, text) in enumerate(self.HELP, 2):
            self.put(y, 1, k, curses.A_BOLD)
            self.put(y, 11, text[: w - 12], curses.A_DIM if not k else 0)
        self.scr.refresh()

    def draw_session(self, y, w, s, base):
        state, attention = self.state_of(s)
        st = self.status.get(s["id"], {})
        c = curses.color_pair
        glyph, color, label = {
            "working": (SPIN[self.frame % len(SPIN)], c(4), age(st.get("since"))),
            "waiting": ("●", c(3) | curses.A_BOLD, "needs you"),
            "done": ("●" if attention else "○", c(2) if attention else curses.A_DIM,
                     "done" if attention else age(st.get("since"))),
            "error": ("✗", c(1), "error"),
            "exited": ("■", curses.A_DIM, "exited"),
            "stopped": ("–", curses.A_DIM, "stopped"),
        }.get(state, ("○", curses.A_DIM, ""))
        gx, tx = (1, 3) if w < 20 else (3, 5)  # a narrow sidebar: less indent
        if s["id"] == self.my_id:
            self.put(y, 0, "▌", base | c(5))
        self.put(y, gx, glyph, base | color)
        if w - tx - len(label) - 2 < 8:  # the title first; the glyph still shows the state
            label = ""
        room = w - tx - 1 - (len(label) + 1 if label else 0)
        title = title_of(s, st)
        title = title if len(title) <= room else title[: room - 1] + "…"
        self.put(y, tx, title, base | (curses.A_BOLD if attention else 0))
        self.put(y, w - len(label) - 1, label, base | (color if state == "waiting" else curses.A_DIM))

    TAB_GLYPHS = {"term": "$", "cmds": "≡", "git": "±", "file": "·"}

    def draw_tab(self, y, w, t, base):
        """A project's tab, under its sessions; bright while a window shows it."""
        gx, tx = (1, 3) if w < 20 else (3, 5)
        label = t["cmd"] if t["kind"] == "term" and t["cmd"] not in SHELLS else t["label"]
        self.put(y, gx, self.TAB_GLYPHS.get(t["kind"], "·"), base | curses.A_DIM)
        self.put(y, tx, label[: w - tx - 1], base | (curses.A_BOLD if t["visible"] else curses.A_DIM))
        if t["kind"] == "git":  # folds like a project: how many files changed, ▸ / ▾
            n = len(self.changes.get(t["project"], []))
            fold = "▾" if t["project"] in self.data["changes_open"] else "▸"
            self.put(y, w - len(str(n)) - 3, f"{n} {fold}", base | curses.A_DIM)
        elif t["pane"] in self.waits:  # a script asks something
            self.put(y, w - 3, "●", base | curses.color_pair(3) | curses.A_BOLD)

    CHANGE_COLORS = {"M": 3, "?": 2, "A": 2, "D": 1, "U": 1}

    def draw_change(self, y, w, change, base):
        """A changed file, under the changes tab; bright while that tab shows its diff."""
        t, st, path = change
        tx = 5 if w < 20 else 7
        room = w - tx - 3
        name = path if len(path) <= room else "…" + path[-room + 1:]
        shown = t["visible"] and t["file"] == path
        self.put(y, tx, st, base | curses.color_pair(self.CHANGE_COLORS.get(st, 3)))
        self.put(y, tx + 2, name, base | (curses.A_BOLD if shown else curses.A_DIM))

    # input

    def prompt(self, label, text="", complete=False, live=None):
        h, w = self.scr.getmaxyx()
        curses.curs_set(1)
        self.scr.timeout(-1)
        try:
            while True:
                if live:
                    live(text)
                self.put(h - 2, 0, " " * w)
                self.put(h - 1, 0, " " * w)
                shown = (label + text)[-(w - 2):]
                self.put(h - 2, 1, shown, curses.A_BOLD)
                self.put(h - 1, 1, "⏎ ok  esc cancel" + ("  tab complete" if complete else ""), curses.A_DIM)
                self.scr.move(h - 2, min(1 + len(shown), w - 1))
                ch = self.scr.get_wch()
                if ch in ("\n", "\r", curses.KEY_ENTER):
                    return text.strip()
                if ch == "\x1b":
                    return None
                if ch in ("\x7f", "\b", curses.KEY_BACKSPACE):
                    text = text[:-1]
                elif ch == "\x15":  # ctrl-u
                    text = ""
                elif ch == "\t" and complete:
                    text = complete_dir(text)
                elif isinstance(ch, str) and ch.isprintable():
                    text += ch
        finally:
            curses.curs_set(0)

    def confirm(self, question, again=None):
        """One key: y (or the key that asked again: x x, a a, R R) is yes, any other no."""
        h, w = self.scr.getmaxyx()
        self.put(h - 2, 0, " " * w)
        self.put(h - 1, 0, " " * w)
        self.put(h - 2, 1, question[:w - 2], curses.A_BOLD)
        self.put(h - 1, 1, f"{again + ' / ' if again else ''}y yes  any key no"[:w - 2], curses.A_DIM)
        self.scr.timeout(-1)
        ch = self.scr.get_wch()
        return ch == "y" or ch == again

    def follow(self):
        """The cursor on a changed file while the changes tab shows: that file's diff (focus stays here)."""
        kind, v = self.current()
        if kind == "change" and v[0]["visible"] and v[0]["file"] != v[2]:
            s = self.here(v[0]["project"])
            if s and self.windows.get(s["id"]) == v[0]["window"]:
                show_changes(v[0], v[2], s["id"], focus=False)

    def move(self, delta):
        if self.items:
            self.cursor = max(0, min(len(self.items) - 1, self.cursor + delta))

    def open(self, item, click=False):
        kind, v = item
        if kind == "pickfile":  # the file meant: its preview, the pick list goes
            with edit_state() as d:
                pick = d.pop("pick", None)
            if pick:
                show_file(pick["zid"], pick["pane"], v, pick["line"])
        elif kind == "project":  # its main session: the first; folded or not, it stays so
            main = next((s for s in self.data["sessions"] if s["cwd"] == v), None)
            if main:
                self.open(("session", main))
            else:
                self.message = "no session: n starts one"
        elif kind == "session":  # its Claude
            wid = self.windows.get(v["id"])
            if not wid and (wid := spawn_window(v)):  # shown once its sidebar has drawn: no blank flash
                end = time.time() + 1.5
                while time.time() < end and "zidev" not in (tmux("capture-pane", "-p", "-t", f"{wid}.0") or ""):
                    time.sleep(0.03)
            if wid:
                show_window(wid)
                claude = claude_tab(v["id"])
                if claude:
                    select_tab(claude["pane"])
        elif kind in ("tab", "change"):  # in this window when it is the project's
            t = v[0] if kind == "change" else v
            s = self.here(t["project"])
            if not s:
                self.message = "no session: n starts one"
            elif kind == "change" and not click and os.path.isfile(changed_path(t["project"], v[2])):
                new_tab(s["id"], "file", file=changed_path(t["project"], v[2]))  # ⏎: the file, as a tab
            elif kind == "tab" and v["kind"] == "git" and v["visible"] and not click:  # shown: ⏎ folds its files
                self.fold_changes(t["project"])
            elif kind == "change":  # a click: its diff
                if show_changes(t, v[2], s["id"]):
                    show_window(self.windows[s["id"]])
                    tmux("select-pane", "-t", t["pane"])
            elif select_tab(v["pane"], s["id"]):
                show_window(self.windows[s["id"]])
                tmux("select-pane", "-t", v["pane"])
                if v["kind"] == "git":  # shown, with its files
                    with edit_state() as d:
                        if t["project"] not in d["changes_open"]:
                            d["changes_open"].append(t["project"])

    def fold(self, cwd, folded=None):
        """Fold / unfold a project's rows (None: the other way round); its session keeps running."""
        with edit_state() as d:
            now = cwd in d["collapsed"]
            want = not now if folded is None else folded
            if want and not now:
                d["collapsed"].append(cwd)
            elif now and not want:
                d["collapsed"].remove(cwd)

    def fold_changes(self, cwd):
        with edit_state() as d:
            if cwd in d["changes_open"]:
                d["changes_open"].remove(cwd)
            else:
                d["changes_open"].append(cwd)

    def side(self, s, kind):
        """Show the project's terminal / commands / git tab in the session's window, a new one if none."""
        wid = self.windows.get(s["id"]) or spawn_window(s)
        if wid:
            show_window(wid)
            show_kind(s["id"], kind)

    def new_in(self, cwd):
        if not cwd:
            return self.new_project()
        if not os.path.isdir(cwd):
            self.message = f"missing: {cwd}"
            return
        new_session(cwd)

    def new_project(self):
        kind, v = self.current()
        cwd = v if kind == "project" else v and v["cwd"]
        default = (os.path.dirname(cwd) if cwd else os.path.expanduser("~/projects")) + "/"
        path = self.prompt("folder: ", default.replace(os.path.expanduser("~"), "~", 1), complete=True)
        if path:
            self.new_in(os.path.realpath(os.path.expanduser(path)))

    def next_attention(self):
        """Open the next session that needs you: waiting ones first, then finished unseen ones."""
        n = len(self.items)
        for wanted in (lambda st: st[0] == "waiting", lambda st: st[1]):
            for step in range(1, n + 1):
                kind, v = self.items[(self.cursor + step) % n]
                if kind == "session" and wanted(self.state_of(v)):
                    self.cursor = (self.cursor + step) % n
                    return self.open(self.items[self.cursor])
        self.message = "nothing needs you"

    def reorder(self, kind, v, delta):
        """Move a session within its project, or a project in the list."""
        with edit_state() as d:
            if kind == "project":
                lst, i = d["projects"], d["projects"].index(v) if v in d["projects"] else -1
                j = i + delta
            else:
                lst = d["sessions"]
                i = next((n for n, s in enumerate(lst) if s["id"] == v["id"]), -1)
                same = [n for n, s in enumerate(lst) if s["cwd"] == v["cwd"]]
                pos = same.index(i) + delta if i in same else -1
                j = same[pos] if 0 <= pos < len(same) else -1
            if i >= 0 and 0 <= j < len(lst):
                lst[i], lst[j] = lst[j], lst[i]

    def find(self):
        def live(text):
            self.filter = text
            self.load()
            self.draw()
        before, kind, v = self.filter, *self.current()
        text = self.prompt("/", self.filter, live=live)
        self.filter = before if text is None else text
        self.load()
        if self.filter:  # first match
            self.cursor = next((i for i, (k, _) in enumerate(self.items) if k == "session"), 0)
        elif kind:
            self.select(self.ident((kind, v)))

    def key(self, ch):
        if ch == curses.KEY_RESIZE:  # not a key: keeps the help open
            return self.fix_width(drag=True)
        self.message = ""
        if self.help:
            self.help = False
            return
        kind, v = self.current()
        sess = self.session_of_item(kind, v)
        if (kind or "").startswith("pick") and ch in (27, ord("x"), ord("X")):  # no pick
            with edit_state() as d:
                d.pop("pick", None)
            return
        if (kind or "").startswith("pick") and ch not in (curses.KEY_DOWN, ord("j"), curses.KEY_UP, ord("k"),
                                                          10, 13, curses.KEY_ENTER, ord(" ")):
            return
        if ch in (25, 5):  # ctrl-y / ctrl-e: the wheel over the sidebar scrolls it, the cursor stays
            self.top, self.scrolled = max(0, min(self.top + (3 if ch == 5 else -3), self.max_top)), True
            return
        if ch != curses.KEY_MOUSE:
            self.scrolled = False
        if ch in (curses.KEY_DOWN, ord("j"), curses.KEY_UP, ord("k")):
            self.move(1 if ch in (curses.KEY_DOWN, ord("j")) else -1)
            self.follow()
        elif ch in (ord(" "), ord("l"), curses.KEY_RIGHT) and kind == "project":  # space folds, l unfolds
            self.fold(v, None if ch == ord(" ") else False)
        elif ch == ord(" ") and kind == "tab" and v["kind"] == "git":
            self.fold_changes(v["project"])
        elif ch in (10, 13, curses.KEY_ENTER, ord("l"), curses.KEY_RIGHT, ord(" ")) and kind:
            self.open((kind, v))
        elif ch in (ord("h"), curses.KEY_LEFT) and kind:
            cwd = self.project_of(kind, v)
            self.fold(cwd, True)
            self.select(("project", cwd))
        elif ch == ord("n"):
            self.new_in(self.project_of(kind, v) if kind else None)
        elif ch == ord("p"):
            self.new_project()
        elif ch == ord("r") and kind == "session":
            st = self.status.get(v["id"], {})
            shown = title_of(v, st)  # a name to edit; not the first prompt, that one is long
            title = self.prompt("name: ", "" if shown in (st.get("prompt"), "new session") else shown)
            if title is not None:
                with edit_state() as d:
                    for s in d["sessions"]:
                        if s["id"] == v["id"]:  # "" gives back Claude's name
                            s["title"], s["title_over"] = title, claude_titles(st.get("transcript"))[0]
        elif ch == ord("r") and kind == "project":
            name = self.prompt("name: ", project_name(v))
            if name is not None:
                rename_project(v, name)
        elif ch in (ord("x"), ord("X")) and kind == "tab":  # X: from the right-click menu, no question
            if v["kind"] == "term" and v["cmd"] not in SHELLS and ch == ord("x") \
                    and not self.confirm(f"stop {v['cmd'][:14]}?", "x"):
                return
            close_tab(v["pane"])
        elif ch in (ord("x"), ord("X")) and kind == "session":
            if ch == ord("X") or self.confirm(f"close '{title_of(v, self.status.get(v['id'], {}))[:14]}'?", "x"):
                close_session(v["id"])
        elif ch in (ord("x"), ord("X")) and kind == "project":
            n = sum(s["cwd"] == v for s in self.data["sessions"])
            if ch == ord("X") or not n or self.confirm(
                    f"remove {project_name(v)[:14]} and {n} session{'s' * (n > 1)}?", "x"):
                remove_project(v)
        elif ch == ord("w"):
            self.next_attention()
        elif ch == ord("a") and kind:
            cwd = self.project_of(kind, v)
            if self.confirm(f"archive {project_name(cwd)[:16]}?", "a"):
                archive_project(cwd)
        elif ch == ord("A"):
            tmux("display-popup", "-E", "-t", self.pane, "-w", "70%", "-h", "60%", "-T", " archived projects ",
                 self_cmd("archived"))
        elif ch == ord("t") and sess:
            self.side(sess, "term")
        elif ch == ord("g") and sess:
            self.side(sess, "git")
        elif ch in (ord("c"), ord("f")) and sess:
            self.side(sess, "cmds")
        elif ch in (ord("J"), ord("K")) and kind in ("project", "session"):
            self.reorder(kind, v, 1 if ch == ord("J") else -1)
        elif ch == ord("R") and kind == "session":
            if self.confirm("restart Claude?", "R"):
                wid = self.windows.get(v["id"])
                if wid:
                    restart_claude(v, wid)
                    show_window(wid)
                else:
                    self.open((kind, v))
        elif ch == ord("/"):
            self.find()
        elif ch == 27 and self.filter:
            self.filter = ""
        elif ch == ord("?"):
            self.help = True
        elif ch in (ord("t"), ord("g"), ord("c"), ord("f"), ord("x"), ord("r"), ord("R"), ord("J"), ord("K")):
            self.message = "select a session first"
        elif ch == curses.KEY_MOUSE:
            self.mouse()

    def mouse(self):
        try:
            _, x, y, _, bstate = curses.getmouse()
        except curses.error:
            return
        if bstate & curses.BUTTON1_PRESSED:
            self.pressed = time.time()
        elif bstate & (curses.BUTTON1_CLICKED | curses.BUTTON1_RELEASED):
            if time.time() - getattr(self, "pressed", 0) < 1:
                return  # the end of a press already handled: a fold must not fold back
            bstate |= curses.BUTTON1_CLICKED  # its press went elsewhere (focus moving here): the release is the click
        if bstate & (curses.BUTTON1_PRESSED | curses.BUTTON1_CLICKED):
            if self.help:
                self.help = False
            elif y in self.rows:
                self.cursor = self.rows[y]
                kind, v = self.items[self.cursor]
                w = self.scr.getmaxyx()[1]
                self.save_view()  # before open: the window it switches to shows the list just like this
                if kind == "project" and x <= 2:  # its ▸ / ▾
                    self.fold(v)
                elif kind == "tab" and v["kind"] == "git" and x >= w - 3:
                    self.fold_changes(v["project"])
                else:
                    self.open((kind, v), click=True)
            else:
                key = next((k for fy, x0, x1, k in self.footer if fy == y and x0 <= x < x1), None)
                if key is not None:
                    self.key(ord(key) if isinstance(key, str) else key)
        elif bstate & (curses.BUTTON3_PRESSED | curses.BUTTON3_CLICKED) and y in self.rows and not self.help:
            self.cursor = self.rows[y]
            self.context_menu(x, y)

    CONTEXT = {"tab": [("Close", "x", "X")],  # (name, shortcut shown, key sent: X closes without asking)
               "session": [("Rename", "r", "r"), ("Restart Claude", "R", "R"), ("Close", "x", "X")],
               "project": [("Rename", "r", "r"), ("New session", "n", "n"), ("Archive", "a", "a"),
                           ("Remove", "x", "X")]}

    def context_menu(self, x, y):
        """Right click on a row: its actions as a menu; each one is the row's key, sent to the sidebar."""
        items = self.CONTEXT.get(self.items[self.cursor][0])
        if not items:
            return
        top = tmux("display", "-p", "-t", self.pane, "#{pane_top}")
        below = int(top or 0) + y + len(items) + 3  # -y is the menu's bottom: it opens just under the row
        menu = ["display-menu", "-M", "-O", "-t", self.pane, "-x", str(x + 1), "-y", str(below)]
        for name, key, sent in items:
            menu += [name, key, f"send-keys -t {self.pane} {sent}"]
        subprocess.Popen(["tmux", "-L", SOCKET, *menu], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

    def fix_width(self, drag=False):
        """Keep the sidebar at its saved width. A resize while the window keeps its width is a drag
        of the border: that width is saved (for every session) instead."""
        size = tmux("display", "-p", "-t", self.pane, "#{pane_width} #{window_width}")
        if not size:
            return
        pane_w, win_w = map(int, size.split())
        if sidebar_hidden():  # zoomed away or a sliver next to Claude's terminal; resize-pane would unzoom
            self.win_w = win_w
            return
        want = sidebar_width()
        if drag and win_w == self.win_w and pane_w != want:
            conf = read_json(CONFIG, {})
            conf["sidebar_w"] = want = max(SIDEBAR_MIN, min(pane_w, win_w - 20))
            write_json(CONFIG, conf)
        if pane_w != want and win_w > want + 20:
            tmux("resize-pane", "-t", self.pane, "-x", str(want))
        self.win_w = win_w

    def paint(self, theme):
        """Colors for the terminal's light or dark theme: text keeps the theme's own colors; the
        selected row gets a gray bar that fits it (reverse video glares: a white block on dark)."""
        if theme == self.theme or curses.COLORS < 256:
            return
        self.theme = theme
        bars = SEL_BARS.get(theme, SEL_BARS["dark"])
        for n, color in enumerate((-1, curses.COLOR_RED, curses.COLOR_GREEN, curses.COLOR_YELLOW,
                                   curses.COLOR_CYAN, curses.COLOR_MAGENTA)):
            for k, bar in enumerate(bars, 1):
                curses.init_pair(k * SEL_PAIR + n, color, bar)
        tmux("set", "-g", "pane-border-style", f"fg=colour{BORDERS.get(theme, BORDERS['dark'])}")
        tmux("set", "-g", "pane-active-border-style", f"fg=colour{BORDERS.get(theme, BORDERS['dark'])}")

    def run(self):
        curses.curs_set(0)
        curses.use_default_colors()
        for n, color in enumerate((curses.COLOR_RED, curses.COLOR_GREEN, curses.COLOR_YELLOW,
                                   curses.COLOR_CYAN, curses.COLOR_MAGENTA), 1):
            curses.init_pair(n, color, -1)
        self.paint("dark")
        curses.mousemask(curses.ALL_MOUSE_EVENTS)
        curses.mouseinterval(0)
        self.scr.keypad(True)
        while True:
            flags = (tmux("display", "-p", "-t", self.pane,
                          "#{window_active} #{session_attached} #{pane_active} #{client_theme}") or "0 0 0").split()
            if len(flags) > 3:  # the terminal's light / dark theme (tmux asks it), as it switches
                self.paint(flags[3])
            if flags[0] != "1" or flags[1] == "0":  # not shown: kept drawn, so a switch here shows it as it is
                self.visible = self.focused = False
                self.load()
                self.adopt_view()
                self.draw()
                self.scr.timeout(500)
                self.scr.getch()
                continue
            self.focused = flags[2] == "1"
            self.load()
            if not self.visible:
                self.visible = True
                self.fix_width()
                self.adopt_view()
                me = next((s for s in self.data["sessions"] if s["id"] == self.my_id), None)
                if me and not (self.items and self.is_mine(self.current(), me)):
                    self.select(("session", self.my_id))
            if self.my_id:
                mark_seen(self.my_id)
            self.frame += 1
            self.draw()
            self.scr.timeout(250)
            ch = self.scr.getch()
            if ch != -1:
                self.key(ch)
                self.save_view()


SEL_PAIR = 10  # color pairs 10-15: on the selection bar, 20-25: on it while the focus is elsewhere
SEL_BARS = {"dark": (238, 236), "light": (252, 254)}  # 256-color grays: the same in every theme
BORDERS = {"dark": 237, "light": 252}


def complete_dir(text):
    path = os.path.expanduser(text)
    matches = sorted(p for p in glob.glob(glob.escape(path) + "*") if os.path.isdir(p))
    if not matches:
        return text
    common = os.path.commonprefix(matches)
    if len(matches) == 1:
        common += "/"
    home = os.path.expanduser("~")
    return common.replace(home, "~", 1) if text.startswith("~") else common


def cmd_sidebar():
    os.environ.setdefault("ESCDELAY", "25")  # esc reacts at once, not after a second
    message = ""
    while True:
        try:
            curses.wrapper(lambda scr: Sidebar(scr, message).run())
        except KeyboardInterrupt:
            message = ""
        except Exception as e:
            log(traceback.format_exc())
            message = f"crashed: {type(e).__name__} (zidev logs)"
            time.sleep(1)


