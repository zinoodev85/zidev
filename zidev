EMPTY_TREE = "4b825dc642cb6eb9a060e54bf8d69288fbee4904"  # git's id of no files: the base before a first commit


def changes(path=None):
    """What changed in the working tree since the last commit, new files included, as one diff
    (of one file: path)."""
    git = lambda *a: subprocess.run(["git", *a], capture_output=True).stdout
    base = "HEAD" if git("rev-parse", "-q", "--verify", "HEAD") else EMPTY_TREE
    out = git("diff", base, "--", *([path] if path else []))
    new = git("ls-files", "--others", "--exclude-standard", "-z", "--", *([path] if path else []))
    for f in filter(None, new.split(b"\0")):
        out += git("diff", "--no-index", "--", "/dev/null", f.decode())
    return out


_changed = {}


def changed_path(cwd, path):
    """The full path of a file git status lists (relative to the repository's top)."""
    top = subprocess.run(["git", "-C", cwd, "rev-parse", "--show-toplevel"], capture_output=True, text=True).stdout.strip()
    return os.path.join(top or cwd, path)


def changed_files(cwd):
    """(status letter, path) of a project's changed files, listed under its changes tab; cached
    a moment (the sidebar redraws often)."""
    hit = _changed.get(cwd)
    if hit and time.time() - hit[0] < 2:
        return hit[1]
    r = subprocess.run(["git", "-C", cwd, "status", "--porcelain=v1", "-z", "-uall"], capture_output=True, text=True)
    parts, files = (r.stdout.split("\0") if r.returncode == 0 else []), []
    while parts:
        entry = parts.pop(0)
        if len(entry) < 4:
            continue
        xy, path = entry[:2], entry[3:]
        if xy[0] in "RC":  # the old name follows
            parts = parts[1:]
        files.append(("?" if xy == "??" else xy[1] if xy[1] != " " else xy[0], path))
    _changed[cwd] = (time.time(), files[:200])
    return files[:200]


def cmd_git(where, file=""):
    """Pane process of the changes tab: the diff of one changed file (delta, n / N next / previous
    change), the one picked under it in the sidebar, else the first; scrolling never runs on into
    another file. esc closes the tab. It is redrawn each time it is shown."""
    if subprocess.run(["git", "rev-parse", "--git-dir"], capture_output=True).returncode:
        diff, msg = b"", "not a git repository"
    else:
        files = [f for _, f in changed_files(os.getcwd())]
        file = file if file in files else files[0] if files else ""
        if os.environ.get("TMUX_PANE"):  # the sidebar marks the file shown
            tmux("set", "-p", "-t", os.environ["TMUX_PANE"], "@zidev_file", file)
        diff = changes(file or None)
        msg = "" if diff else f"no changes in {file}" if file else "no changes since the last commit"
    if diff:
        numbers, top, rows, origin = False, None, [], []

        def page():  # delta at the pane's width; our less keeps delta's n / N between files and hunks
            width = columns()
            shown = subprocess.run(["delta", "--dark", f"--syntax-theme={THEME['bat']}", "--paging=never",
                                    "--navigate", *(["--line-numbers"] if numbers else []), f"--width={width}",
                                    "--hunk-header-decoration-style=none"],
                                   input=diff, capture_output=True).stdout.decode(errors="replace")
            rows[:], origin[:] = [], []  # screen rows, and the diff line each one comes from
            for i, l in enumerate(shown.split("\n")):
                for r in wrap_ansi(l, width).split("\n"):
                    rows.append(r)
                    origin.append(i)
            at = [f"+{origin.index(top) + 1}g", "-j1"] if top is not None and top in origin else \
                ["-p", "^(commit|added:|copied:|Δ|removed:|renamed:|•)"]
            prompt = re.sub(r"([%?:.\\])", r"\\\1", f"{file}   esc close  ⏎ open file  n / N next / previous change  l lines  /search")
            return pager("\n".join(rows).encode(), ["-X", *at, f"-Ps{prompt}"],
                         {**os.environ, "LESSKEY_CONTENT": LESSKEYS + "#command\nl quit l\n\\n quit o\n"})
        while (status := until_resized(page)) in (108, 111):
            top = origin[top_line(rows) - 1]  # staying where you are
            if status == 108:  # l: line numbers on / off
                numbers = not numbers
                continue
            path, zid = changed_path(os.getcwd(), file), zid_of_pane(os.environ.get("TMUX_PANE"))
            if zid and os.path.isfile(path):  # ⏎: the file itself, as a tab
                new_tab(zid, "file", file=path)
    else:
        print(f"\n  \033[2m{msg}\n\n  esc closes\033[0m")
        with contextlib.suppress(Exception):
            import termios
            import tty
            fd, old = sys.stdin.fileno(), termios.tcgetattr(sys.stdin.fileno())
            try:
                tty.setcbreak(fd)
                while sys.stdin.read(1) not in ("\x1b", ""):
                    pass
            finally:
                termios.tcsetattr(fd, termios.TCSADRAIN, old)
    leave_tab()


