def cmd_reload():
    """New code without a restart: re-read tmux.conf, respawn sidebars, welcome and commands panes.
    Claude and terminal panes keep running (R in the sidebar restarts a Claude)."""
    if not server_running():
        sys.exit("zidev is not running")
    tmux("source-file", TMUX_CONF)
    install_tmux_hooks()
    out = tmux("list-panes", "-s", "-t", SESSION, "-F",
               "#{pane_id} #{pane_index} #{window_name} #{@zidev_id} #{@zidev_side}") or ""
    n = 0
    for line in out.splitlines():
        pane, index, name, zid, side = (line.split(" ") + [""] * 5)[:5]
        cmd = (self_cmd("sidebar") if index == "0" else
               self_cmd("welcome") if name == "home" and not zid else
               None)
        if cmd:
            tmux("respawn-pane", "-k", "-t", pane, cmd)
            n += 1
        cwd = session_of(zid).get("cwd")
        if cwd and index == "1" and not side:  # Claude, from before it was a tab
            mark_tab(pane, cwd, "claude", owner=zid)
        elif side in ("files", "cmds"):  # the commands tab of older versions: the palette has it
            tmux("kill-pane", "-t", pane)
    out = tmux("list-panes", "-a", "-F", "#{pane_id} #{@zidev_side} #{@zidev_owner} #{@zidev_project}") or ""
    for pane, side, owner, project in (l.split(" ", 3) for l in out.splitlines() if l.count(" ") >= 3):
        cwd = session_of(owner).get("cwd")
        if side in TAB_KINDS and not project and cwd:  # from before tabs were the project's
            tmux("set", "-p", "-t", pane, "@zidev_project", cwd)
        if side in TAB_KINDS and side != "claude" and owner:
            tmux("set", "-pu", "-t", pane, "@zidev_owner")
    for line in (tmux("list-panes", "-a", "-F", "#{pane_id} #{@zidev_side}") or "").splitlines():
        if line.endswith(" cmds"):
            tmux("kill-pane", "-t", line.split()[0])
    for cwd in {t["project"] for t in all_tabs()}:
        sync_tabs(cwd)
    print(f"reloaded {n} panes; Claude sessions and terminals untouched")


