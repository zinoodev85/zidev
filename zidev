def cmd_cmds(where):
    """Pane process of the commands bar: one fuzzy list of package scripts, make targets and files.
    ⏎ runs a script in the terminal pane, opens markdown in the viewer, other files in micro;
    `>cmd` runs any shell command."""
    env = micro_env()
    fzf = ["fzf", "--ansi", "--delimiter=\t", "--with-nth=2", "--layout=reverse", "--border=none",
           "--info=inline-right", "--prompt=❯ ", "--print-query", "--expect=ctrl-e,ctrl-v,ctrl-g",
           "--header=⏎ run / open  ^e edit  ^v view  ^g grep  >cmd shell  esc close\n"
                     "new name + ⏎ creates a file",
           "--preview", self_cmd("preview") + " {1} {3} {4}",
           "--preview-window=right,55%,border-left,<110(down,50%,border-top)",
           "--bind=enter:accept-or-print-query", "--bind=ctrl-d:preview-half-page-down",
           "--bind=ctrl-u:preview-half-page-up"]
    lister = ["fd", "--type=f", "--hidden", "--follow", *(f"--exclude={d}" for d in SKIP_DIRS)]
    cwd = where if os.path.isdir(where) else session_of(where).get("cwd") or os.getcwd()
    while True:
        info = project_info(load_state(), cwd)
        found = subprocess.run(lister, capture_output=True, text=True).stdout.splitlines()
        recent = [f for f in info["recent"] if os.path.isfile(f)]
        runs = project_commands(found)
        done = info["recent_cmds"]
        runs.sort(key=lambda r: done.index(r[2]) if r[2] in done else len(done))  # last run first
        rows = [f"run\t\033[32m▶\033[0m {label}  \033[2m{hint}\033[0m\t{d}\t{cmd}" for label, hint, cmd, d in runs]
        rows += [f"file\t{f}\t{f}\t" for f in recent + [f for f in found if f not in recent]]
        r = subprocess.run(fzf, input="\n".join(rows), stdout=subprocess.PIPE, text=True, env=env)
        if r.returncode not in (0, 1):  # esc / ctrl-c
            break
        lines = r.stdout.split("\n")
        query, key = lines[0], lines[1] if len(lines) > 1 else ""
        picked = lines[2].split("\t") if len(lines) > 2 and lines[2] else None
        if key == "ctrl-g":
            path, line = grep(query, env)
            if path:
                add_recent(cwd, path)
                subprocess.call(["micro", f"+{line}", path], env=env)
            continue
        if picked and picked[0] == "run":
            run_in_term(cwd, picked[3], picked[2])
            continue
        if not picked and query.strip().startswith(">"):
            if query.strip()[1:].strip():
                run_in_term(cwd, query.strip()[1:].strip(), ".")
            continue
        path = picked[2] if picked else query.strip()
        if not path:
            continue
        add_recent(cwd, path)
        if key == "ctrl-v" or (key != "ctrl-e" and is_markdown(path) and os.path.exists(path)):
            page_file(path, env=env)
        else:
            subprocess.call(["micro", path], env=env)
    leave_tab()


