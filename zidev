def archived():
    return load_state().get("archived", [])


def archive_project(cwd):
    """Hide a project from the sidebar: its sessions and tabs stop (saved, back on unarchive)."""
    sync_tabs(cwd)
    with edit_state() as d:
        if cwd not in d.setdefault("archived", []):
            d["archived"].append(cwd)
    if not server_running():
        return
    zids = {s["id"] for s in load_state()["sessions"] if s["cwd"] == cwd}
    wins = session_windows()
    for t in all_tabs():
        if t["project"] == cwd and not t["visible"]:
            tmux("kill-pane", "-t", t["pane"])
    mine = tmux("display", "-p", "#{window_id}") if os.environ.get("TMUX") else None
    for wid in sorted((w for z, w in wins.items() if z in zids), key=lambda w: w == mine):
        tmux("kill-window", "-t", wid)  # the caller's own window last


def remove_project(cwd):
    """A project out of the sidebar with its sessions and tabs: they stop (its folder stays)."""
    zids = [s["id"] for s in load_state()["sessions"] if s["cwd"] == cwd]
    with edit_state() as d:
        d["projects"] = [p for p in d["projects"] if p != cwd]
        d["sessions"] = [s for s in d["sessions"] if s["cwd"] != cwd]
        for key in ("project_tabs", "names"):
            d.get(key, {}).pop(cwd, None)
        d["changes_open"] = [c for c in d.get("changes_open", []) if c != cwd]
    for zid in zids:
        for path in (f"{STATUS_DIR}/{zid}.json", f"{SEEN_DIR}/{zid}"):
            with contextlib.suppress(OSError):
                os.remove(path)
    if not server_running():
        return
    wins = session_windows()
