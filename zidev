        f.write(f"#!/bin/sh\ncat > {root}/copied\n")
    os.chmod(f"{root}/copy", 0o755)
    with open(f"{root}/guess", "w") as f:  # stands in for the AI asked which file a name means
        f.write("#!/bin/sh\ncat >/dev/null\nsleep 1\necho lib/Dup.ts\n")
    os.chmod(f"{root}/guess", 0o755)
    fake = f"{root}/claude"
