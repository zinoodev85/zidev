    ("cmd-shift-left", "M-A", "send-keys C-a"), ("cmd-shift-right", "M-E", "send-keys C-e"),
    ("alt-backspace", "M-BSpace", "send-keys C-w"), ("cmd-backspace", "M-k", "send-keys C-u"),
    ("alt-up", "Up", "send-keys Up"), ("alt-down", "Down", "send-keys Down"),
    ("alt-shift-up", "M-K", ""), ("alt-shift-down", "M-J", ""),  # move the line
    ("cmd-shift-up", "M-K", ""), ("cmd-shift-down", "M-J", ""),
    ("cmd-d", "C-d", ""), ("cmd-y", "M-k", ""), ("cmd-/", "M-/", ""),  # duplicate, delete, comment the line
    ("cmd-l", "M-g", ""), ("cmd-r", "M-r", ""),  # go to line, replace
    ("cmd-g", "M-n", ""), ("cmd-shift-g", "M-p", ""))]  # next / previous match
EDIT_KEYS = [(f"\x1b[5;{30106 + n}~", *k) for n, k in enumerate(EDIT_KEYS)]
ITERM_KEYS = {"x": (0x78, 0x7), "c": (0x63, 0x8), "f": (0x66, 0x3), "a": (0x61, 0x0), "s": (0x73, 0x1),
              "z": (0x7a, 0x6), "d": (0x64, 0x2), "y": (0x79, 0x10), "l": (0x6c, 0x25), "r": (0x72, 0xf),
              "g": (0x67, 0x5), "/": (0x2f, 0x2c), "backspace": (0x7f, 0x33),
              "left": (0xf702, 0x7b), "right": (0xf703, 0x7c), "up": (0xf700, 0x7e), "down": (0xf701, 0x7d)}


def iterm_keys(key):
    """iTerm keyboard-map entries (char-modifiers-keycode) for a key like cmd-shift-z or alt-left."""
    *mods, name = key.split("-") if not key.endswith("/") else [*key[:-2].split("-"), "/"]
    char, code = ITERM_KEYS[name]
    flags = sum({"cmd": 0x100000, "alt": 0x80000, "shift": 0x20000}[m] for m in mods)
    flags |= 0x200000 if name in ("left", "right", "up", "down") else 0  # arrows: the numeric pad flag
    chars = {char, ord(chr(char).upper())} if "shift" in mods and len(name) == 1 else {char}
    extra = ["0x2f-0x120000-0x1a"] if name == "/" else []  # German layout: / is shift-7
    return [f"0x{c:x}-0x{flags:x}-0x{code:x}" for c in chars] + extra
ZED_KEYS["bindings"].update({key: ["terminal::SendText", seq] for seq, key, _, _ in EDIT_KEYS})


def install_tmux_hooks():
    me = shlex.join(self_argv())
    tmux("set-hook", "-gu", "window-layout-changed")  # older versions
    tmux("set-hook", "-g", "pane-exited", f"run-shell -b \"{me} tabsync\"")
    for hook in ("session-window-changed", "window-pane-changed", "client-session-changed", "client-attached",
                 "client-detached", "client-light-theme", "client-dark-theme"):
        tmux("set-hook", "-g", hook, f"run-shell -b \"touch {shlex.quote(SWITCHED)}\"")
    tmux("bind", "-n", "C-q", *palette_popup("#{pane_id}"))  # the palette where cmd-k does not reach zidev
    # keys Zed sends for cmd-w / cmd-t while a terminal shows zidev (see ZED_KEYS)
    for n, (seq, action) in enumerate(USER_KEYS):
        tmux("set", "-s", f"user-keys[{n}]", seq)
        tmux("bind", "-n", f"User{n}", *(palette_popup("#{pane_id}") if action == "palette" else
                                          ["run-shell", "-b", f"{me} tab {action} '#{{pane_id}}'"]))
    for n, (seq, _, ctrl, otherwise) in enumerate(EDIT_KEYS, len(USER_KEYS)):
        tmux("set", "-s", f"user-keys[{n}]", seq)
        tmux("bind", "-n", f"User{n}", "if-shell", "-F", "#{==:#{pane_current_command},micro}",
             f"send-keys {ctrl}", *([otherwise] if otherwise else []))
    # in the floating preview esc closes it, enter docks it as a tab (passed on while editing the file)
    # esc closes file, changes and commands views too (they run less); claude gets its esc straight
    for key, action in (("Escape", "esc"), ("Enter", "enter")):
        where = "#{pane_floating_flag}" if key == "Enter" else \
            "#{||:#{pane_floating_flag},#{m:*|#{@zidev_side}|*,|file|git|}}"
        tmux("bind", "-n", key, "if-shell", "-F", where,
             f"run-shell -b \"{me} tab {action} '#{{pane_id}}'\"", f"send-keys {key}")
    tmux("unbind", "-n", "MouseDown1Status")  # the tab bar of older versions
    # a click on a file path opens it (preview, browser or default app); the app under it never gets
    # that click, other clicks reach it as usual. The sidebar is skipped without asking zidev.
    at = "'#{pane_id}' '#{mouse_x}' '#{mouse_y}'"
    ispath = f"{me} ispath {at} '#{{mouse_hyperlink}}'"
    tmux("bind", "-n", "MouseDown1Pane", "select-pane", "-t", "=", "\\;", "if-shell", "-F", "#{==:#{pane_index},0}",
         "send-keys -M", f"if-shell \"{ispath}\" '' 'send-keys -M'")
    # a double click on a `! command` in Claude types it into its prompt; elsewhere it selects a word
    word = ("select-pane -t = ; if-shell -F '#{||:#{pane_in_mode},#{mouse_any_flag}}' { send-keys -M } "
            "{ copy-mode -H ; send-keys -X select-word ; run-shell -d 0.3 ; send-keys -X copy-pipe-and-cancel }")
    tmux("bind", "-n", "DoubleClick1Pane", "if-shell", "-F", "#{==:#{@zidev_side},claude}",
         f"if-shell \"{me} bang {at}\" '' {{ {word} }}", word)
    # cmd-click: the zidev app sends it as ctrl-alt-click (a terminal can't report cmd); on a
    # `! command` in Claude it runs it, elsewhere it is a plain click
    # in the sidebar a cmd-click is a click. In Claude the pane is focused only once its screen is read:
    # focusing first makes Claude redraw, and the row clicked would hold another line by then
    tmux("bind", "-n", "C-M-MouseDown1Pane", "if-shell", "-F", "#{==:#{pane_index},0}",
         "select-pane -t = ; send-keys -M", f"if-shell -F '#{{==:#{{@zidev_side}},claude}}' "
         f"{{ run-shell -b \"{me} bang {at} run\" }} {{ select-pane -t = ; run-shell -b \"{me} click {at}\" }}")
    # its release: the sidebar's, else no one's (focusing here would race the screen read)
    tmux("bind", "-n", "C-M-MouseUp1Pane", "if-shell", "-F", "#{==:#{pane_index},0}", "send-keys -M")
    tmux("bind", "-n", "MouseUp1Pane", "set", "-gF", "@zidev_link", "#{mouse_hyperlink}", "\\;",
         "if-shell", "-F", "#{==:#{pane_index},0}", "send-keys -M",
         f"if-shell \"{ispath}\" \"run-shell -b \\\"{me} click {at}\\\"\" 'send-keys -M'")
    # the wheel scrolls everywhere: apps with mouse support get the event, full-screen apps
    # without it (glow, bat / less) get arrow keys, a plain shell scrolls its history
    # always the pane under the mouse (-t =), never the focused one; over the sidebar: its scroll keys
    for wheel, arrow, otherwise, side in (("WheelUpPane", "Up", "copy-mode -e -t =", "C-y"),
                                          ("WheelDownPane", "Down", "", "C-e")):
        less = (f"if-shell -t = -F '#{{||:#{{alternate_on}},#{{m:*|#{{@zidev_side}}|*,|file|git|}}}}' "
                f"'send-keys -t = -N 3 {arrow}' '{otherwise}'")  # file / changes views: less -X, no alternate screen
        tmux("bind", "-n", wheel, "if-shell", "-t", "=", "-F", "#{&&:#{==:#{pane_index},0},#{@zidev_id}}",
             f"send-keys -t = {side}",
             "if-shell -t = -F '#{||:#{pane_in_mode},#{mouse_any_flag}}' 'send-keys -M' { " + less + " }")
    tmux("set", "-g", "status", "off")  # no tab bar: tabs are listed in the sidebar


