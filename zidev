# ── main ───────────────────────────────────────────────────────────────────

def main():
    # tmux keeps a file open per pane: macOS allows a process 256, tmux started from here gets more
    soft, hard = resource.getrlimit(resource.RLIMIT_NOFILE)
    try:
        resource.setrlimit(resource.RLIMIT_NOFILE, (max(soft, min(hard, 10240)), hard))
    except (ValueError, OSError):
        pass
    args = sys.argv[1:]
    cmd = args[0] if args else ""
    if cmd == "hook":
        return cmd_hook()
    if cmd == "width":  # a hook of older versions
        return
    if cmd == "ispath":  # every click in a pane: keep it light
        return cmd_ispath(*args[1:5])
    if cmd in ("click", "bang", "tab", "tabsync", "html"):  # tmux bindings and hooks
        try:
            {"click": lambda: cmd_click(*args[1:4]), "bang": lambda: cmd_bang(*args[1:5]), "tab": lambda: cmd_tab(args[1:]),
             "tabsync": cmd_tabsync, "html": lambda: cmd_html(*args[1:5])}[cmd]()
        except Exception:
            log(f"{cmd}: {traceback.format_exc()}")
        return
    migrate_home()
    setup_dirs()
    if cmd in ("", "start") and old_server_running():
        sys.exit("the old zmux server is still running with the same sessions.\n"
                 "stop it first (sessions are saved; Claude resumes): tmux -L zmux kill-server")
    if cmd == "":
        cmd_start()
    elif cmd == "start":
        ensure_server()
    elif cmd == "new":
        cmd_new(args[1:])
    elif cmd == "rename-project":
        cmd_rename_project(args[1:])
    elif cmd in ("archive", "unarchive"):
        cmd_archive(args[1:], cmd == "archive")
    elif cmd == "list":
        cmd_list(args[1:])
    elif cmd == "status":
        cmd_list(["--json"])
    elif cmd == "kill":
        cmd_kill()
    elif cmd == "reload":
        cmd_reload()
    elif cmd == "doctor":
        cmd_doctor()
    elif cmd == "guess":
        cmd_guess(args[1])
    elif cmd == "logs":
        cmd_logs(args[1:])
    elif cmd == "selftest":
        cmd_selftest()
    elif cmd == "apptest":
        cmd_apptest()
    elif cmd == "run":
        cmd_run(args[1])
    elif cmd == "term":
        cmd_term(args[1])
    elif cmd == "git":
        cmd_git(*args[1:3])
    elif cmd == "palette":
        cmd_palette(args[1])
    elif cmd == "palette-tab":
        cmd_palette_tab(*args[1:4])
    elif cmd == "palette-rows":
        cmd_palette_rows(*args[1:4])
    elif cmd == "view":
        cmd_view(*args[1:3])
    elif cmd == "open":
        cmd_open(args[1:])
    elif cmd == "preview":
        cmd_preview(*args[1:4])
    elif cmd == "sidebar":
        cmd_sidebar()
    elif cmd == "welcome":
        cmd_welcome()
    elif cmd == "app":
        cmd_app()
    elif cmd == "keys":  # for the zidev app: which key sends what (the iTerm profile's map, by name)
        print(json.dumps({**{k: v[1] for k, v in ZED_KEYS["bindings"].items()},
                          **{key: seq for seq, key, _, _ in EDIT_KEYS}}))
    elif cmd == "palette-argv":  # for the zidev app: how it starts the palette panel at once, without a shell
        print(json.dumps(self_argv("palette", "float")))
    elif cmd in ("--version", "version"):
        print(f"zidev {VERSION}")
    elif os.path.isdir(os.path.expanduser(cmd)):
        cmd_open_dir(cmd)
    else:
        print(__doc__)


if __name__ == "__main__":
    main()
