def package_manager(d):
    """pnpm / yarn / bun / npm for a package folder, from the lockfile or packageManager nearest to it."""
    d = os.path.abspath(d)
    while True:
        for lock, pm in (("pnpm-lock.yaml", "pnpm"), ("pnpm-workspace.yaml", "pnpm"), ("yarn.lock", "yarn"),
                         ("bun.lock", "bun"), ("bun.lockb", "bun"), ("package-lock.json", "npm")):
            if os.path.exists(f"{d}/{lock}"):
                return pm
        pm = str(read_json(f"{d}/package.json", {}).get("packageManager", "")).partition("@")[0]
        if pm:
            return pm
        up = os.path.dirname(d)
        if up == d or d == os.path.expanduser("~"):
            return "pnpm"
        d = up


def workspace_globs(d):
    """Workspace member globs of the package in folder d (package.json workspaces, pnpm-workspace.yaml)."""
    ws = read_json(f"{d}/package.json", {}).get("workspaces") or []
    globs = list(ws.get("packages", []) if isinstance(ws, dict) else ws)
    with contextlib.suppress(OSError):
        m = re.search(r"^packages:\s*\n((?:[ \t]+.*\n?|\s*\n)*)", open(f"{d}/pnpm-workspace.yaml").read(), re.M)
        globs += re.findall(r"^\s*-\s*['\"]?([^'\"#\n]+?)['\"]?\s*$", m[1] if m else "", re.M)
    return [g for g in globs if isinstance(g, str) and not g.startswith("!")]


def project_packages(files):
    """The project's own package.json files: the top two levels and their workspace members,
    not every vendored or fixture package somewhere below."""
    own = [f for f in files if os.path.basename(f) == "package.json" and f.count("/") <= 1]
    members = set()
    for f in own:
        d = os.path.dirname(f) or "."
        for g in workspace_globs(d):
            members.update(os.path.normpath(p) for p in glob.glob(f"{d}/{g.rstrip('/')}/package.json"))
    keep = set(own) | {f for f in files if os.path.normpath(f) in members}
    return sorted(keep, key=lambda f: (f.count("/"), f))


def project_commands(files):
    """(label, hint, command, folder) for the package.json scripts and Makefile targets in the project."""
    runs = []
    for f in project_packages(files):
        d = os.path.dirname(f) or "."
        pm = package_manager(d)
        where = "" if d == "." else f"{d}: "
        run = "" if pm in ("pnpm", "yarn") else " run"
        for name, script in (read_json(f, {}).get("scripts") or {}).items():
            runs.append((f"{where}{name}", str(script), f"{pm}{run} {name}", d))
        runs.append((f"{where}install", f"{pm} install", f"{pm} install", d))
    for f in (f for f in files if os.path.basename(f) in ("Makefile", "makefile") and f.count("/") <= 1):
        d = os.path.dirname(f) or "."
        where = "" if d == "." else f"{d}: "
        with contextlib.suppress(OSError):
            for m in re.finditer(r"^([A-Za-z0-9][\w.-]*):(?!=)", open(f).read(), re.M):
                runs.append((f"{where}make {m[1]}", "Makefile", f"make {m[1]}", d))
    return runs


def run_in_term(cwd, cmd, folder):
    """Type a command into an idle terminal tab of the project (all busy: a new one) and show it
