# less everywhere: esc (sent as ^] by tmux) closes, q does nothing; in a file e quits with status 101 to edit it
LESSKEYS = "#command\n^] quit\nq noaction\nQ noaction\nZZ noaction\n#line-edit\n^] abort\n"


def page_file(path, line=None, env=None):
    """A file in less until esc: markdown rendered (glow), code highlighted (bat) with the branch's changes;
    e edits it (micro, at the line) and shows it again, l shows / hides line numbers where you are."""
    if os.path.isdir(path):  # a folder: its tree, two levels
        tree = subprocess.run(["eza", "--tree", "-L", "2", "--color=always", "--group-directories-first",
                               "--git-ignore", path], capture_output=True) if shutil.which("eza") else None
        listing = tree.stdout if tree and tree.returncode == 0 else \
            subprocess.run(["ls", "-la", "-G", path], capture_output=True, env={**os.environ, "CLICOLOR_FORCE": "1"}).stdout
        env = {**(env or micro_env()), "LESSKEY_CONTENT": LESSKEYS}
        until_resized(lambda: pager(listing, ["-X", "-Ps" + view_prompt(path, "esc close  /search")], env))
        return
    md = is_markdown(path)
    env = {**(env or micro_env()), "LESSKEY_CONTENT": LESSKEYS + "#command\ne quit e\n" + ("" if md else "l quit l\n")}
    prompt = "-Ps" + view_prompt(path, "esc close  e edit  " + ("" if md else "l lines  ") + "/search")
    numbers, top, text, origin = False, None, [], []  # origin: the file line of each screen row

    def page():
        if md:
            text[:] = [subprocess.run(["glow", "-s", THEME["glow"], "-w", str(max(20, columns() - 4)), path],
                                      capture_output=True, env=env).stdout.decode(errors="replace")]
            return pager(text[0].encode(), ["-X", prompt], env)
        shown, origin[:] = render_file(path, line, numbers)
        text[:] = shown.split("\n")
        row = lambda n: origin.index(n) + 1 if n in origin else 1  # a long line takes several rows
        at = [f"+{row(top)}g", "-j1"] if top else ["-j.3", f"+{row(int(line))}g"] if line else []
        if len(text) < shutil.get_terminal_size().lines:  # all of it fits: from its first line, never moved
            at = []
        return pager("\n".join(text).encode(), ["-X", prompt, *at], env)
    while True:
        status = until_resized(page)
        if status == 108:  # l
            top, numbers = origin[top_line(text) - 1], not numbers
            continue
        if status != 101:
            return
        if not md:  # the editor opens where you are; the viewer comes back there
            top = origin[top_line(text) - 1]
        subprocess.call(["micro", f"+{top or line or 1}", path], env=env)


def top_line(lines):
    """The number of the first of lines that less (-X) left on the screen when it quit; 1 if unsure."""
    width = columns()
    rows = subprocess.run(["tmux", "-L", SOCKET, "capture-pane", "-p", "-t", os.environ.get("TMUX_PANE", "")],
                          capture_output=True, text=True).stdout.split("\n")[:-2]  # not the prompt row
    plain = [ANSI.sub("", l).rstrip() for l in lines]

    screen, start = [], []  # the rows less shows, folded at the width, and the line each one starts
    for i, l in enumerate(plain):
        cols = columns_to_index(l)
        for a in range(0, max(1, len(cols)), width):
            screen.append(l[cols[a]:cols[min(a + width, len(cols)) - 1] + 1].rstrip() if cols else "")
            start.append(i + 1 if a == 0 else None)
    for skip in range(3):  # the top row may be the end of a folded line
        want = [r.rstrip() for r in rows[skip:skip + 6] if r.strip() != "~"]
        if not "".join(want).strip():
            continue
        for k in range(len(screen)):
            if start[k] and screen[k:k + len(want)] == want:
                return start[k]
    return 1


ANSI = re.compile(r"\033\[[0-9;]*m")


def wrap_ansi(line, width, hang=None):
    """A colored line folded at width (delta does not wrap): continuation rows keep the colors and
    sit right of the line-number gutter (" 85 ⋮ 86 │"); with hang, they start that many columns in
    (code: under its own indentation, a bit further)."""
    line = re.sub(r"\033\[[0-9;]*[A-Za-ln-z]", "", line)  # only colors: less -R shows nothing else
    plain = ANSI.sub("", line)
    if len(columns_to_index(plain)) <= width:
        return line
    bar = plain.find("│")
    indent = hang if hang is not None else bar + 1 if 0 <= bar < 16 else 0
    rows, row, used, state = [], "", 0, ""
    for seq, ch in re.findall(r"(\033\[[0-9;]*m)|(.)", line, re.S):
        if seq:
            row += seq
            state = "" if seq in ("\033[0m", "\033[m") else state + seq
            continue
        w = 2 if len(columns_to_index(ch)) == 2 else 1
        if used + w > width:
            rows.append(row + "\033[0m")
            row = state + " " * indent if hang is not None else \
                " " * (indent - 1) + "\033[2m│\033[0m" + state if indent else state
            used = indent
        row += ch
        used += w
    rows.append(row + " " * max(0, width - used) + "\033[0m" if state else row)
    return "\n".join(rows)


def columns():
    try:
        return os.get_terminal_size(sys.__stdout__.fileno()).columns
    except OSError:
        return 80


def pager(text, args, env=None):
    """less -R showing text (bytes); its Popen, still running. Calm: painted from the top (-c), no ~ rows,
    a gray prompt line."""
    less = subprocess.Popen(["less", "-R", "-c", "--tilde", "--use-color", "--color=PK-", *args],
                            stdin=subprocess.PIPE, env=env)
    with contextlib.suppress(BrokenPipeError):
        less.stdin.write(text)
        less.stdin.close()
    return less


def until_resized(start):
    """Run start() (a Popen drawn at the pane's width) until it ends; when the pane's width changes
    (the tab moved, the window resized), draw it again at the new width. Its exit status."""
    resized = []
    old = signal.signal(signal.SIGWINCH, lambda *_: resized.append(1))
    try:
        while True:
            width, proc = columns(), start()
            while proc.poll() is None:
                if resized:
                    resized.clear()
                    if columns() != width:
                        proc.terminate()
                        proc.wait()
                        break
                time.sleep(0.05)
            else:
                return proc.returncode
    finally:
        signal.signal(signal.SIGWINCH, old)


def branch_base(cwd):
    """(commit, name) the branch started from: merge-base with origin's default branch (else main/master).
    On that branch itself: HEAD, so only uncommitted changes show."""
    git = lambda *a: subprocess.run(["git", "-C", cwd, *a], capture_output=True, text=True).stdout.strip()
    names = [git("symbolic-ref", "--short", "refs/remotes/origin/HEAD"), "origin/main", "origin/master", "main", "master"]
    for name in filter(None, names):
        base = git("merge-base", "HEAD", name)
        if base:
            return base, name.removeprefix("origin/")
    return (git("rev-parse", "--verify", "-q", "HEAD") or None), "HEAD"


def branch_marks(path):
    """{line: "added" | "changed" | "deleted"} of a file's changes on this branch (commits and uncommitted),
    and the branch's base name; ({}, None) outside git."""
    cwd = os.path.dirname(path)
    git = lambda *a: subprocess.run(["git", "-C", cwd, *a], capture_output=True, text=True)
    if git("rev-parse", "--git-dir").returncode:
        return {}, None
    base, name = branch_base(cwd)
    if git("ls-files", "--error-unmatch", path).returncode or not base:  # new on this branch
        with open(path, errors="replace") as f:
            return {n: "added" for n in range(1, sum(1 for _ in f) + 1)}, name
    marks = {}
    diff = git("diff", "-U0", "--no-color", "--no-ext-diff", base, "--", path).stdout
    for old, start, count in re.findall(r"^@@ -\d+(?:,(\d+))? \+(\d+)(?:,(\d+))? @@", diff, re.M):
        old, start, count = int(old or 1), int(start), int(count or 1)
        if count == 0:
            marks.setdefault(max(start, 1), "deleted")
        for n in range(start, start + count):
            marks[n] = "changed" if old else "added"
    return marks, name


def render_file(path, line=None, numbers=False):
    """A code file for less: line numbers (when asked), branch-change marks (like an editor gutter) and
    the highlighted code; a long line folds under its own indentation, right of the gutter.
    The text and the file line of each of its rows."""
    width = columns()
    marks, base = branch_marks(path)
    digits = len(str(sum(1 for _ in open(path, "rb")))) + 1 if numbers else 0
    room = max(10, width - 3 - digits)  # code columns right of the gutter, one spare
    code = subprocess.run(["bat", "--color=always", "--paging=never", "--style=plain", "--wrap=never", "--tabs=4",
                           f"--terminal-width={room}",
                           *([f"--highlight-line={line}"] if line else []), path],
                          capture_output=True, text=True, errors="replace").stdout.split("\n")
    if code and code[-1] == "":
        code.pop()
    color = {"added": "\033[32m▎", "changed": "\033[33m▎", "deleted": "\033[31m▁"}
    out, origin = [], []
    tint, ansi = "\033[48;2;24;48;32m", re.compile(r"\033\[[0-9;]*m")
    for n, text in enumerate(code, 1):
        if marks.get(n) in ("added", "changed") and str(n) != str(line):  # the clicked line keeps bat's highlight
            pad = room - len(columns_to_index(ansi.sub("", text)))
            text = tint + text.replace("\033[0m", "\033[0m" + tint) + " " * max(0, pad) + "\033[0m"
        number = f"\033[2m{n:>{digits - 1}}\033[0m " if numbers else ""
        mark = color.get(marks.get(n), " ") + "\033[0m "
        lead = len(ansi.sub("", text)) - len(ansi.sub("", text).lstrip(" "))
        for k, part in enumerate(wrap_ansi(text, room, min(lead + 4, room // 2)).split("\n")):
            out.append(f"{number if k == 0 else ' ' * len(ansi.sub('', number))}{mark}{part}")
            origin.append(n)
    return "\n".join(out) + "\n", origin


def view_prompt(path, keys):
    """less's prompt line: the file, what its marks compare to, the keys."""
    rel = os.path.relpath(path)
    name = rel if not rel.startswith("..") else path.replace(os.path.expanduser("~"), "~", 1)
    base = branch_marks(path)[1] if not is_markdown(path) else None
    vs = f"  ▎ changed vs {base}" if base and base != "HEAD" else "  ▎ uncommitted" if base else ""
    return re.sub(r"([%?:.\\])", r"\\\1", f"{name}{vs}   {keys}")


PATH_SEPARATORS = set(" \t()[]{}<>'\"`,;|│⎿⏺●•→")


def columns_to_index(line):
    """Map screen column → character index (wide characters take two columns)."""
    import unicodedata
    cols = []
    for i, ch in enumerate(line):
        cols += [i] * (2 if unicodedata.east_asian_width(ch) in "WF" else 1)
    return cols


def token_at(lines, y, x, width):
    """The path-like words under screen position (x, y), longest first: the word itself, and joined
    with the rows it may wrap onto (a word that ends its row goes on at the start of the next one,
    after its indent; Claude wraps long paths at - and / and indents the rest)."""
    if not 0 <= y < len(lines):
        return []
    line = lines[y]
    cols = columns_to_index(line)
    if x >= len(cols) or line[cols[x]] in PATH_SEPARATORS:
        return []
    a = b = cols[x]
    while a > 0 and line[a - 1] not in PATH_SEPARATORS:
        a -= 1
    while b < len(line) and line[b] not in PATH_SEPARATORS:
        b += 1
    before, after = [], []  # the pieces on the rows above / below
    row, end = y, line[b:]
    while not end.strip() and row + 1 < len(lines) and len(after) < 3:
        nxt = lines[row + 1]
        start = len(nxt) - len(nxt.lstrip(" "))
        stop = next((i for i in range(start, len(nxt)) if nxt[i] in PATH_SEPARATORS), len(nxt))
        if stop == start:
            break
        after.append(nxt[start:stop])
        row, end = row + 1, nxt[stop:]
    row, lead = y, line[:a]
    while not lead.strip() and row > 0 and len(before) < 3:
        prv = lines[row - 1].rstrip(" ")
        start = next((i + 1 for i in range(len(prv) - 1, -1, -1) if prv[i] in PATH_SEPARATORS), 0)
        if start == len(prv):
            break
        before.insert(0, prv[start:])
        row, lead = row - 1, prv[:start]
    words = {"".join(before[len(before) - i:]) + line[a:b] + "".join(after[:j])
             for i in range(len(before) + 1) for j in range(len(after) + 1)}
    return sorted(words, key=len, reverse=True)


def resolve_path(word, cwd):
    """(path, line) of an existing file named by a word like src/a.ts:12:3, ./x.md, ~/x, file:///x."""
    word = word.removeprefix("file://").rstrip(".:,")
    m = re.match(r"^(.*?)(?::(\d+)(?::\d+)?|#L(\d+))?$", word)
    path, line = m[1], m[2] or m[3]
    for base in (cwd, ""):
        full = os.path.normpath(os.path.join(base, os.path.expanduser(path))) if path else ""
        if full and os.path.isfile(full):
            return full, line
    return None, None


def line_in(word, path):
    """The line a shown word like UITicket.svelte.ts:96 names, when a link to path carries none."""
    m = re.match(r"^(.*?)(?::(\d+)(?::\d+)?|#L(\d+))[.:,]?$", word)
    return (m[2] or m[3]) if m and os.path.basename(m[1]) == os.path.basename(path) else None


FILE_NAME = re.compile(r"^([\w.@+-]+(?:/[\w.@+-]+)*\.[A-Za-z][A-Za-z0-9]{0,7})(?::(\d+)(?::\d+)?|#L(\d+))?[.:,]?$")


def unique_file(word, root, text=""):
    """(path, line) of the one file a bare name names; None when no file or several have it."""
    hits, line = files_named(word, root, text)
    return (hits[0], line) if len(hits) == 1 else (None, None)


def files_named(word, root, text=""):
    """([paths], line) of the files a bare name names (before-table.png, Cart.ts:12, models/Cart.ts): the AI
    often writes only the name. Looked for in the full paths shown earlier (text), then in the project's
    files (git, else its folder)."""
    m = FILE_NAME.match(word)
    if not m:
        return [], None
    name, line = m[1], m[2] or m[3]
    shown = {os.path.normpath(os.path.join(root or "/", os.path.expanduser(p)))
             for p in re.findall(r"[\w.~@+/-]*/" + re.escape(name) + r"(?![\w.-])", text)}
    hits = sorted(p for p in shown if os.path.isfile(p))
    if hits or not root:
        return hits, line
    try:
        top = subprocess.run(["git", "-C", root, "rev-parse", "--show-toplevel"],
                             capture_output=True, text=True, timeout=2).stdout.strip()
        files = subprocess.run(["git", "-C", top, "ls-files", "-co", "--exclude-standard"],
                               capture_output=True, text=True, timeout=2).stdout.splitlines() if top else []
    except (OSError, subprocess.TimeoutExpired):
        return [], None
    if not top:  # no repo: the folder, without hidden ones and node_modules, up to a limit
        top, files = root, []
        for d, dirs, names in os.walk(root):
            dirs[:] = [x for x in dirs if not x.startswith(".") and x != "node_modules"]
            files += [os.path.relpath(os.path.join(d, x), root) for x in names]
            if len(files) > 20000:
                break
    return sorted(os.path.join(top, f) for f in files if f == name or f.endswith("/" + name)), line


