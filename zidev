def cmd_doctor():
    ok = True

    def check(good, what, fix=""):
        nonlocal ok
        ok = ok and good
        print(f"  {'\033[32m✓' if good else '\033[31m✗'}\033[0m {what}" + ("" if good or not fix else f"\n      → {fix}"))

    print("tools")
    for tool, fix, needed in (("tmux", "brew install tmux", True), (CLAUDE, "npm i -g @anthropic-ai/claude-code", True),
                              ("fzf", "brew install fzf", False), ("fd", "brew install fd", False),
                              ("bat", "brew install bat", False), ("glow", "brew install glow", False),
                              ("delta", "brew install git-delta", False),
                              ("micro", "brew install micro", False), ("rg", "brew install ripgrep", False)):
        path = shutil.which(tool)
        check(bool(path), f"{tool}" + ("" if needed else " (commands bar)") + (f"  {path}" if path else ""), fix)
    v = subprocess.run(["tmux", "-V"], capture_output=True, text=True).stdout.split()
    ver = v[1] if len(v) > 1 else "?"
    check(ver >= "3.3", f"tmux {ver} (3.3+ for extended keys)", "brew upgrade tmux")
    print("setup")
    hooks = read_json(HOOK_SETTINGS, {}).get("hooks", {})
    check(set(HOOK_EVENTS) <= set(hooks), f"hook settings {HOOK_SETTINGS}", "run zidev once to rewrite it")
    check(os.access(SELF, os.X_OK), f"zidev executable {SELF}", f"chmod +x {SELF}")
    on_path = shutil.which("zidev")
    check(bool(on_path) and os.path.realpath(on_path) == os.path.realpath(SELF), "zidev on PATH",
          f"ln -sf {SELF} ~/.local/bin/zidev")
    try:
        with open(STATE) as f:
            d = json.load(f)
        check(True, f"state {STATE}: {len(d.get('sessions', []))} sessions")
        for sess in d.get("sessions", []):
            if not os.path.isdir(sess["cwd"]):
                check(False, f"session folder missing: {sess['cwd']}", "close it in the sidebar (x)")
    except FileNotFoundError:
        check(True, "no sessions yet")
    except ValueError as e:
        check(False, f"state file unreadable: {e}", f"fix or move away {STATE}")
    print("server")
    running = server_running()
    check(True, f"socket {SOCKET}: " + ("running" if running else "not running (zidev starts it)"))
    if running:
        wins = session_windows()
        missing = [x for x in load_state()["sessions"] if x["id"] not in wins]
        check(not missing, f"{len(wins)} session windows", "zidev start (restores missing windows)")
    if os.path.exists(LOG) and os.path.getsize(LOG):
        check(True, f"log {LOG} ({os.path.getsize(LOG)} bytes; zidev logs)")
    sys.exit(0 if ok else 1)


