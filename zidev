def palette_used(rows, cwd):
    """The palette's top: [(key, row)] picked last (3), then most (3, twice or more), that still fit here.
    rows: the rows there are now, by key; a file or script fits in its project (cwd) only."""
    fit = {}
    for k, u in read_json(PALETTE_USED, {}).items():
        kind = k.split("\t")[0]
        if k in rows:
            fit[k] = u, rows[k]
        elif kind == "run" and cwd and k.split("\t")[1] == cwd:
            fit[k] = u, u["row"]
        elif kind == "file" and cwd and k[5:].startswith(cwd + "/") and os.path.isfile(k[5:]):
            rel = os.path.relpath(k[5:], cwd)
            fit[k] = u, f"file\t{rel}\t{rel}\t"
    last = sorted(fit, key=lambda k: -fit[k][0]["t"])[:3]
    most = [k for k in sorted(fit, key=lambda k: -fit[k][0]["n"]) if k not in last and fit[k][0]["n"] > 1][:3]
    return [(k, fit[k][1]) for k in last + most]


