def cmd_tab(args):
    """`zidev tab ACTION [PANE]`: the keys and the palette."""
    action, pane = args[0], (args[1] if len(args) > 1 else os.environ.get("TMUX_PANE", ""))
    zid = zid_of_pane(pane)
    if action == "select":
        select_tab(pane)
    elif action == "close":
        t = find_tab(pane) or (shown_in(session_windows().get(zid)) if zid else None)
        if t:
            close_tab(t["pane"])
    elif action == "claude" and zid:
        claude = claude_tab(zid)
        if claude:
            select_tab(claude["pane"])
    elif action == "close-key":  # cmd-w: the focused tab, else the preview; never a tab you don't see focused
        t = find_tab(pane) or (floating_in(session_windows().get(zid)) if zid else None)
        if t:
            close_tab(t["pane"])
    elif action == "git" and zid:
        show_kind(zid, "git")
    elif action in ("esc", "enter"):  # in the floating preview, a file or changes tab
        tty = tmux("display", "-p", "-t", pane, "#{pane_tty}") or ""
        ps = subprocess.run(["ps", "-t", tty.removeprefix("/dev/"), "-o", "comm="], capture_output=True, text=True)
        running = {os.path.basename(c) for c in ps.stdout.split()}
        t = find_tab(pane)
        if action == "esc" and "less" in running:  # less closes on ^] (a plain esc would also end arrow keys)
            tmux("send-keys", "-t", pane, "C-]")
        elif not (t and t["float"]) or "micro" in running:
            tmux("send-keys", "-t", pane, "Escape" if action == "esc" else "Enter")
        elif action == "esc":
            close_tab(pane)
        else:
            pin_tab(pane)
    elif action == "pin":
        pin_tab(pane)
    elif action in ("next", "prev"):
        cycle_tab(pane, 1 if action == "next" else -1)
    elif action in ("up", "down"):
        cycle_tab(pane, 1 if action == "down" else -1, items=True)
    elif action == "sidebar":
        toggle_sidebar()
    elif action == "split":
        toggle_split(pane)
    elif action == "term" and zid:
        new_tab(zid, action)


