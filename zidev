def cmd_palette(pane):
    """The palette (cmd-k), like WebStorm's Search Everywhere: tabs on top (⇥ switches), ⏎ does what is picked.
    All, empty: what was picked last and most, the common actions, the projects; typing searches everything
    (actions, sessions, tabs, archived, apps, the project's scripts and files), the last row searches Google.
    Text searches inside the project's files, Clipboard lists the copies zidev.app keeps (⏎ pastes one).
    `>cmd` runs a shell command in a terminal tab, `file:line` opens there.
    pane "float": in zidev.app's panel over another app (shift-shift), on zidev's current session."""
    floating = pane == "float"
    if not pane.startswith("%"):  # from a key binding (tmux does not fill in #{pane_id} there): the client's pane
        pane = tmux("display", "-p", "#{pane_id}") or ""
    os.environ["TMUX_PANE"] = pane  # run_in_term: this window's session
    wid = tmux("display", "-p", "-t", pane, "#{window_id}") or ""
    zid = zid_of_pane(pane)
    d = load_state()
    s = session_of(zid)
    cwd = s.get("cwd") or (d["projects"][0] if d["projects"] else os.path.expanduser("~"))
    have = {"session": bool(s), "project": cwd in d["projects"]}
    acts = {}  # rows by key (palette_key)
    for label, hint, what in PALETTE_ACTIONS:
        row = what.split()[-1] if what.startswith("side") else "session" if what.startswith("tab") else "-"
        if have.get(row, True):
            name = f"{label} · {project_name(cwd)}" if row == "project" else label
            acts[f"act\t{what}"] = f"act\t\033[36m›\033[0m {name}  {dim(hint)}\t{what}\t"
    common = [k for k in acts if k.split("\t")[1] in PALETTE_COMMON]
    live = [p for p in d["projects"] if p not in archived()]
    projects = {f"project\t{p}": f"project\t▾ {project_name(p)}  {dim(p)}\t{p}\t" for p in live}
    found = {f"session\t{x['id']}": f"session\t◆ {title_of(x, read_status(x['id']))}  {dim(project_name(p))}\t{x['id']}\t"
             for p in live for x in d["sessions"] if x["cwd"] == p}
    found.update({f"tab\t{t['pane']}": f"tab\t▤ {t['label']}  {dim(project_name(cwd))}\t{t['pane']}\t"
                  for t in (project_tabs(cwd) if s else [])})
    found.update({f"archived\t{c}": f"archived\t▸ {project_name(c)}  {dim('archived · ⏎ unarchives')}\t{c}\t"
                  for c in archived()})
    rows = {**acts, **projects, **found}
    apps = {f"app\t{a}": f"app\t◇ {os.path.basename(a)[:-4]}  {dim('app')}\t{a}\t" for a in mac_apps()}
    top = palette_used({**rows, **apps}, cwd if s else None)
    empty = [r for _, r in top] + [rows[k] for k in common + list(projects) if k not in dict(top)]
    work = tempfile.mkdtemp(prefix="zidev-palette-")
    full = f"{work}/full"
    with open(f"{work}/empty", "w") as f:
        f.write("\n".join(empty) + "\n")
    with open(f"{work}/tab", "w") as f:
        f.write("All")
    folder = cwd if s else ""  # the project's files, scripts and text: only from one of its sessions
    # fzf does not search: palette-rows gives it the rows for the tab and what is typed, on every key;
    # fzf only marks the letters that match (palette_search)
    fzf = ["fzf", "--ansi", "--disabled", "--no-sort", "--delimiter=\t", "--with-nth=2", "--layout=reverse", "--border=none",
           "--info=inline-right", "--prompt=❯ ", "--with-shell=sh -c", "--header-first", f"--header={palette_header('All')}",
           f"--bind=change:execute-silent(touch {work}/pending)+first+{palette_search(work)}"
           f"+reload-sync:{self_cmd('palette-rows', work, folder)} {{q}}",
           # ⏎ while the rows for what was typed are still coming: picked once they are there, not the old ones
           f"--bind=enter:transform:[ -e {work}/pending ] && touch {work}/enter || echo accept",
           f"--bind=load:transform:rm -f {work}/pending; [ -e {work}/enter ] && echo accept",
           f"--bind=tab:transform:{self_cmd('palette-tab', work, folder, '1')}",
           f"--bind=btab:transform:{self_cmd('palette-tab', work, folder, '-1')}",
           "--preview", self_cmd("preview") + " {1} {3} {4}",
           "--preview-window=right,50%,border-left,<110(down,50%,border-top),hidden",  # files, scripts, text only
           "--bind=focus:transform:[ {1} = file ] || [ {1} = run ] || [ {1} = text ] || [ {1} = clip ] "
           "&& echo show-preview || echo hide-preview",
           "--bind=ctrl-d:preview-half-page-down", "--bind=ctrl-u:preview-half-page-up"]
    if os.path.isdir(cwd):
        os.chdir(cwd)

    def full_list():  # while fzf shows the short one: the scripts and files take a moment
        more = []
        try:
            if folder and os.path.isdir(cwd):
                lister = ["fd", "--type=f", "--hidden", "--follow", *(f"--exclude={x}" for x in SKIP_DIRS)]
                files = subprocess.run(lister, capture_output=True, text=True).stdout.splitlines()
                info = project_info(d, cwd)
                runs, done = project_commands(files), info["recent_cmds"]
                runs.sort(key=lambda r: done.index(r[2]) if r[2] in done else len(done))  # last run first
                recent = [f for f in info["recent"] if os.path.isfile(f)]
                more = [f"run\t\033[32m▶\033[0m {label}  {dim(hint)}\t{x}\t{c}" for label, hint, c, x in runs]
                more += [f"file\t{f}\t{f}\t" for f in recent + [f for f in files if f not in recent]]
        finally:  # the rest comes even when the scripts or files could not be read
            shown = {r for _, r in top}
            with contextlib.suppress(OSError), open(f"{full}.part", "w") as f:
                f.write("\n".join([r for _, r in top] + [r for r in [*rows.values(), *more, *apps.values()] if r not in shown]) + "\n")
            with contextlib.suppress(OSError):
                os.rename(f"{full}.part", full)
            save_titles()

    threading.Thread(target=full_list, daemon=True).start()
    try:
        with open(f"{work}/empty") as f:
            out = subprocess.run(fzf, stdin=f, stdout=subprocess.PIPE, text=True)
    finally:
        shutil.rmtree(work, ignore_errors=True)
    picked = out.stdout.rstrip("\n").split("\t") if out.returncode == 0 and out.stdout.strip() else None
    if not picked:
        return
    if picked[0] not in ("google", "text", "clip"):  # a search or a copy does not come on top next time
        palette_note(out.stdout.rstrip("\n"), cwd)
    if picked[0] == "clip":  # into the tab beside the sidebar, never into the sidebar
        here = tmux("display", "-p", "-t", pane, "#{pane_index}")
        paste_clip(picked[2], None if floating else f"{wid}.1" if here == "0" else pane)
        return
    palette_do(picked[0], picked[2], picked[3] if len(picked) > 3 else "", pane, wid, zid, cwd)
    if floating and picked[0] not in ("app", "google"):  # it is in zidev's window now: that comes to the front
        tell_app("show")


