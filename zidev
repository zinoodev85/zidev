ITERM_PROFILES = os.path.expanduser("~/Library/Application Support/iTerm2/DynamicProfiles")


def iterm_profile():
    """An iTerm profile for zidev tabs: your default profile plus cmd-w / cmd-t sent to zidev
    (the USER_KEYS sequences), running zidev itself. Written once; iTerm picks up changes by itself."""
    keys = {"0x77-0x100000-0xd": USER_KEYS[0][0], "0x74-0x100000-0x11": USER_KEYS[1][0],  # cmd-w, cmd-t
            "0x62-0x100000-0xb": USER_KEYS[2][0],  # cmd-b
            "0xf700-0x300000-0x7e": USER_KEYS[3][0], "0xf701-0x300000-0x7d": USER_KEYS[4][0],  # cmd-↑, cmd-↓
            "0x54-0x120000-0x11": USER_KEYS[5][0], "0x74-0x120000-0x11": USER_KEYS[5][0],  # cmd-shift-t
            "0x6b-0x100000-0x28": USER_KEYS[6][0]}  # cmd-k
    for seq, key, _, _ in EDIT_KEYS:  # mac / WebStorm editing keys
        keys.update({k: seq for k in iterm_keys(key)})
    profile = {"Profiles": [{"Name": "zidev", "Guid": "zidev-profile", "Tags": ["zidev"],
                             "Custom Command": "Yes", "Command": iterm_command(),
                             "Keyboard Map": {k: {"Action": 10, "Text": seq[1:]} for k, seq in keys.items()}}]}
    path = f"{ITERM_PROFILES}/zidev.json"
    if read_json(path, None) != profile:
        os.makedirs(ITERM_PROFILES, exist_ok=True)
        with open(path, "w") as f:  # no temp file: iTerm would read that too
            json.dump(profile, f, indent=2)

def iterm_command(env=()):
    """zidev in an interactive login shell (PATH as in your other tabs), as an iTerm command line."""
    run = "exec " + " ".join(shlex.quote(a) for a in (sys.executable, SELF))
    return " ".join([*(["/usr/bin/env", *map(shlex.quote, env)] if env else []), "/bin/zsh", "-lic", shlex.quote(run)])


def iterm_open_tab():
    """iTerm ignores the SetProfile escape, so zidev opens in a new tab that has the zidev profile."""
    cmd = iterm_command([f"{k}={v}" for k, v in os.environ.items() if k.startswith("ZIDEV_")])
    q = lambda x: '"' + x.replace("\\", "\\\\").replace('"', '\\"') + '"'
    me = os.environ.get("ITERM_SESSION_ID", "").partition(":")[2]  # the tab zidev was typed in
    script = f'''tell application "iTerm2"
  set target to current window
  repeat with w in windows
    repeat with t in tabs of w
      repeat with s in sessions of t
        if unique id of s is {q(me)} then set target to w
      end repeat
    end repeat
  end repeat
  tell target to create tab with profile "zidev" command {q(cmd)}
end tell'''
    return subprocess.run(["osascript", "-e", script], capture_output=True).returncode == 0


def cmd_start():
    if in_zidev():
        sys.exit("already inside zidev (cmd-k / ctrl-q: the palette)")
    ensure_server()
    os.chdir(ANCHOR)
    env = {k: v for k, v in os.environ.items() if k != "TMUX"}
    if os.environ.get("TERM_PROGRAM") == "iTerm.app":
        iterm_profile()  # cmd-w / cmd-t only reach zidev in a tab with this profile
        if os.environ.get("ITERM_PROFILE") != "zidev" and iterm_open_tab():
            return print("zidev opened in a new tab (Profiles > zidev opens it directly)")
    os.execvpe("tmux", ["tmux", "-L", SOCKET, "attach", "-t", SESSION], env)


def in_zidev():
    return os.environ.get("TMUX", "").split(",")[0].endswith(f"/{SOCKET}")


def cmd_open_dir(path):
    """zidev DIR (zidev .): zidev showing that folder's project, on its first session; new if it is none."""
    cwd = os.path.realpath(os.path.expanduser(path))
    ensure_server()
    if cwd in archived():
        unarchive_project(cwd)
    first = next((s for s in load_state()["sessions"] if s["cwd"] == cwd), None)
    if not first:
        new_session(cwd)  # shows its window
    elif wid := session_windows().get(first["id"]) or spawn_window(first):
        show_window(wid)
    if not in_zidev():
        cmd_start()


def cmd_app():
    """zidev.app (brew puts it next to zidev; from source app/build.sh builds it) into ~/Applications, then opened."""
    src = next((p for p in (os.path.join(HERE, "..", "zidev.app"), os.path.join(HERE, "app", "build", "zidev.app"))
                if os.path.isdir(p)), None)
    if not src:
        sys.exit("no zidev.app built: run app/build.sh")
    dst = os.path.expanduser("~/Applications/zidev.app")
    os.makedirs(os.path.dirname(dst), exist_ok=True)
    shutil.rmtree(dst, ignore_errors=True)
    shutil.copytree(src, dst, symlinks=True)
    # the one running (it keeps running, ZI79) quits first, so the new one starts; in a shell of its own, as
    # this may run inside that app
    subprocess.Popen(["sh", "-c", "osascript -e 'if application \"zidev\" is running then quit application \"zidev\"'"
                      f"; sleep 1; open {shlex.quote(dst)}"], start_new_session=True)
    print(f"zidev.app is in {os.path.dirname(dst)} (Spotlight, Launchpad, Dock)")


def archived():
    return load_state().get("archived", [])


def archive_project(cwd):
    """Hide a project from the sidebar. Nothing of it keeps running: its sessions and tabs stop (saved,
    back on unarchive), and so does what they left running. How many such processes stopped."""
    sync_tabs(cwd)
    with edit_state() as d:
        if cwd not in d.setdefault("archived", []):
            d["archived"].append(cwd)
    return stop_project(cwd, {s["id"] for s in load_state()["sessions"] if s["cwd"] == cwd})


def stop_project(cwd, zids):
    """Stop a project's session windows (zids), its tabs and what they left running."""
    wins = {w for z, w in session_windows().items() if z in zids}
    panes = []  # the pids of its panes: tmux stops them
    for line in (tmux("list-panes", "-a", "-F", "#{pane_pid}\t#{window_id}\t#{@zidev_project}") or "").splitlines():
        pid, wid, project = line.split("\t")
        if wid in wins or project == cwd:
            panes.append(int(pid))
    leftovers = project_leftovers(cwd, panes)
    for pid in leftovers:
        with contextlib.suppress(OSError):
            os.kill(pid, signal.SIGTERM)
    for t in all_tabs():
        if t["project"] == cwd:
            tmux("kill-pane", "-t", t["pane"])
    mine = tmux("display", "-p", "#{window_id}") if os.environ.get("TMUX") else None
    for wid in sorted(wins, key=lambda w: w == mine):
        tmux("kill-window", "-t", wid)  # the caller's own window last
    return len(leftovers)


def project_leftovers(cwd, panes):
    """What would keep running when a project's panes stop: all they started, and orphans (their parent
    gone) working in its folder, e.g. a dev server Claude left running, a preview server. Never this
    process, the ones it runs in, or a tmux server."""
    parent, command = {}, {}
    for line in subprocess.run(["ps", "-axo", "pid=,ppid=,command="], capture_output=True, text=True).stdout.splitlines():
        pid, ppid, cmd = (line.split(None, 2) + [""])[:3]
        parent[int(pid)], command[int(pid)] = int(ppid), cmd
    children = {}
    for pid, ppid in parent.items():
        children.setdefault(ppid, []).append(pid)
    # orphans in its folder, not in a project inside it
    projects = set(load_state()["projects"]) | {cwd}
    orphans = [pid for pid, ppid in parent.items()
               if ppid == 1 and os.path.basename(command[pid].split(" ")[0]) != "tmux"]
    roots = list(panes)
    for pid, folder in working_folders(orphans).items():
        owners = [p for p in projects if folder == p or folder.startswith(p + "/")]
        if owners and max(owners, key=len) == cwd:
            roots.append(pid)
    found = set()
    while roots:  # with their children, and theirs
        pid = roots.pop()
        if pid not in found:
            found.add(pid)
            roots += children.get(pid, [])
    pid = os.getpid()  # this process and the ones it runs in (the sidebar's pane, tmux) stop with the panes
    while pid > 1 and pid in parent:
        found.discard(pid)
        pid = parent[pid]
    return found - set(panes)


def working_folders(pids):
    """{pid: its working folder}, for the ones lsof may read (mine)."""
    if not pids:
        return {}
    out = subprocess.run(["lsof", "-a", "-d", "cwd", "-Fpn", "-p", ",".join(map(str, pids))],
                         capture_output=True, text=True).stdout
    folders, pid = {}, None
    for line in out.splitlines():
        if line.startswith("p"):
            pid = int(line[1:])
        elif line.startswith("n") and pid:
            folders[pid] = line[1:]
    return folders


def remove_project(cwd):
    """A project out of the sidebar with its sessions and tabs: they stop, and what they left running
    (its folder stays)."""
    zids = [s["id"] for s in load_state()["sessions"] if s["cwd"] == cwd]
    with edit_state() as d:
        d["projects"] = [p for p in d["projects"] if p != cwd]
        d["sessions"] = [s for s in d["sessions"] if s["cwd"] != cwd]
        for key in ("project_tabs", "names"):
            d.get(key, {}).pop(cwd, None)
        d["changes_open"] = [c for c in d.get("changes_open", []) if c != cwd]
        d["commits_open"] = [c for c in d.get("commits_open", []) if c != cwd]
    for zid in zids:
        for path in (f"{STATUS_DIR}/{zid}.json", f"{SEEN_DIR}/{zid}"):
            with contextlib.suppress(OSError):
                os.remove(path)
    stop_project(cwd, set(zids))


def unarchive_project(cwd):
    with edit_state() as d:
