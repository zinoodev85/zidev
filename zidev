def project_info(d, cwd):
    """A project's recent files and commands; from before they were the project's: its sessions'."""
    old = [s for s in d["sessions"] if s["cwd"] == cwd]
    info = d.get("project_info", {}).get(cwd) or {
        k: list(dict.fromkeys(x for s in old for x in s.get(k, []))) for k in ("recent", "recent_cmds")}
    info.setdefault("recent", [])
    info.setdefault("recent_cmds", [])
    return info


def remember(cwd, key, item, keep):
    with edit_state() as d:
        info = d.setdefault("project_info", {}).setdefault(cwd, project_info(d, cwd))
        info[key] = [item] + [x for x in info.get(key, []) if x != item][: keep - 1]


def add_recent(cwd, path):
    remember(cwd, "recent", path, 10)


def cmd_preview(kind, target, extra=""):
    """The palette's preview. extra: a script's command, or the line of a file (from Text or file:line)."""
    width = os.environ.get("FZF_PREVIEW_COLUMNS", "80")
    if kind == "clip":  # a copy: from where and when, then its whole text (an image: its size)
        c = next((c for c in read_json(f"{CLIPS}/index.json", []) if c["id"] == target), None)
        if c:
            print(dim(f"{c['app']} · {time.strftime('%d.%m.%Y %H:%M', time.localtime(c['t']))}") + "\n")
            print(clip_text(target) or c["text"])
    elif kind == "run":
        print(f"\033[1m$ {extra}\033[0m\n\033[2min {os.path.abspath(target)}\033[0m\n\n⏎ runs it in the terminal pane")
    elif not os.path.isfile(target):
        print("\033[2mnew file\033[0m")
    elif extra:  # at the line: from a little above it, the line marked
        start = max(1, int(extra) - int(os.environ.get("FZF_PREVIEW_LINES", "30")) // 3)
        subprocess.call(["bat", "--color=always", "--style=changes", f"--highlight-line={extra}",
                         f"--line-range={start}:{start + 400}", f"--terminal-width={width}", target])
    elif is_markdown(target):
        subprocess.call(["glow", "-s", THEME["glow"], "-w", width, target])
    else:
        subprocess.call(["bat", "--color=always", "--style=changes", "--line-range=:400",
                         f"--terminal-width={width}", target])


def read_key():
    fd = sys.stdin.fileno()
    old = termios.tcgetattr(fd)
    try:
        tty.setcbreak(fd)
        return sys.stdin.read(1)
    finally:
        termios.tcsetattr(fd, termios.TCSADRAIN, old)


