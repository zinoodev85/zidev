echo "fake claude $*"
printf '{"hook_event_name":"SessionStart","session_id":"%s"}' "$ZIDEV_TEST_CID" | "$ZIDEV_SELF" hook
exec sleep 3600
"""


@contextlib.contextmanager
def edit_state_at(home):
    path = f"{home}/sessions.json"
    d = read_json(path, {})
    yield d
    write_json(path, d)


def cmd_selftest():
    """End to end on a throwaway server (own socket and home, fake claude): start, new session,
    hook states, side panes, reload, restore after kill. Exit status 1 if anything fails."""
    import tempfile
    root = tempfile.mkdtemp(prefix="zidev-selftest-")
    home, proj = f"{root}/home", f"{root}/proj"
    os.makedirs(proj)
    with open(f"{proj}/README.md", "w") as f:
        f.write("# hello\n")
    with open(f"{proj}/package.json", "w") as f:
        f.write('{"scripts": {"greet": "echo hi-from-script"}}')
