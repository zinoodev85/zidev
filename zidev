LOOKS_LIKE_FILE = re.compile(r"^[\w.~@+-]*/[\w./@+-]*\.[A-Za-z][A-Za-z0-9]{0,7}(:\d+(:\d+)?)?[.:,]?$")


def color_runs(row):
    """A captured row (capture-pane -e) as runs of one color: [(first column, end column, text, color)]."""
    import unicodedata
    runs, state, col = [], "", 0
    for seq, ch in re.findall(r"\033\[([0-9;]*)m|(.)", row, re.S):
        if not ch:
            state = "" if seq in ("", "0") else state + ";" + seq
            continue
        n = 2 if unicodedata.east_asian_width(ch) in "WF" else 1
        if runs and runs[-1][3] == state:
            runs[-1][1], runs[-1][2] = col + n, runs[-1][2] + ch
        else:
            runs.append([col, col + n, ch, state])
        col += n
    return [tuple(r) for r in runs]


def fg_of(state):
    """The text color a color_runs state ends on ("" for the default)."""
    codes, fg = [c for c in state.split(";") if c], ""
    while codes:
        c = codes.pop(0)
        if c == "38" and codes:
            n = 4 if codes[0] == "2" else 2
            fg, codes = ";".join(["38", *codes[:n]]), codes[n:]
        elif c in ("39", "0"):
            fg = ""
        elif c.isdigit() and (30 <= int(c) <= 37 or 90 <= int(c) <= 97):
            fg = c
        elif c == "48" and codes:
            codes = codes[4 if codes[0] == "2" else 2:]
    return fg


def bang_at(rows, y, x, width=None):
    """The `! command` Claude suggests under (x, y), without its !: its inline-code run (one color),
    or a row that is only "! command"; one that fills its row goes on at the start of the next
    (a long path wraps mid-word: joined without a space). A click on a wrapped part counts too."""
    rows = [re.sub(r"\033\]8;[^\033\a]*(\033\\|\a)", "", r) for r in rows]  # no hyperlinks
    if not 0 <= y < len(rows):
        return None
    hit = bang_from(rows, y, x, width)
    if hit:
        return hit[0]
    lead = next((r for r in color_runs(rows[y]) if r[2].strip()), None)
    if not lead or not lead[0] <= x < lead[1]:
        return None
    for up in range(1, 5):  # a wrapped part: the command starts a row or more above
        plain = ANSI.sub("", rows[max(y - up, 0)])
        hit = y - up >= 0 and bang_from(rows, y - up, len(plain.rstrip()) - 1, width)
        if hit and hit[1] >= y:
            return hit[0]
    return None


def bang_from(rows, y, x, width):
    """bang_at at its first row: (the command, the last row it wraps onto), or None."""
    plain = ANSI.sub("", rows[y])
    runs = color_runs(rows[y])
    indent = len(plain) - len(plain.lstrip())
    if re.match(r"\s*! ?\S", plain) and x >= indent:  # a line of its own
        first = next((r for r in runs if r[2].strip()), None)
        run = (indent, len(plain.rstrip()), plain.strip(), first[3] if first else "")
    else:
        run = next((r for r in runs if r[0] <= x < r[1]), None)
        if not run or not run[3] or not re.match(r"\s*! ?\S", run[2]):
            return None
    text, end, last = run[2], run[1], y
    for nxt in rows[y + 1:y + 5]:  # wrapped: the same color goes on after the indent
        if end < len(plain.rstrip()) or (width and end < width - 20):
            break
        lead = next((r for r in color_runs(nxt) if r[2].strip()), None)
        if not lead or fg_of(lead[3]) != fg_of(run[3]) or lead[0] > 8 or lead[2].lstrip().startswith("!"):
            break
        full = width and end >= width - 2  # cut mid-word at the edge, not at a space
        text = text.rstrip() + ("" if full else " ") + lead[2].strip()
        plain, end, last = ANSI.sub("", nxt), lead[1], last + 1
    cmd = text.strip()[1:].strip().strip("`")
    return (cmd, last) if cmd else None


def clicked_path(pane, x, y, link=""):
    """What a click at (x, y) hits: (zid, path, line) for a file, (zid, None, word) for a path to a file
    that does not exist, (zid, "url", url) for a web link, None for anything else (plain text, the sidebar)."""
    info = tmux("display", "-p", "-t", pane, "#{pane_current_path}\t#{pane_width}\t#{pane_index}")
    zid = zid_of_pane(pane)
    if not info or not zid:
        return None
    cwd, width, index = info.split("\t")
    if index == "0":  # the sidebar
        return None
    s = session_of(zid) or {}
    if tmux("display", "-p", "-t", pane, "#{@zidev_side}") == "claude":  # `! cmd`: into Claude's prompt
        cmd = bang_at((tmux("capture-pane", "-p", "-e", "-t", pane) or "").split("\n"), int(y), int(x), int(width))
        if cmd:
            return zid, "bang", cmd
    words = token_at((tmux("capture-pane", "-p", "-t", pane) or "").split("\n"), int(y), int(x), int(width))
    for w in filter(None, [link if link.startswith(("file://", "/", "~")) else "", *words]):
        for base in (cwd, s.get("cwd", cwd)):
            path, line = resolve_path(w, base)
            if path:
                return zid, path, line or next(filter(None, (line_in(v, path) for v in words)), None)
    for w in words:  # a folder (anime/v2/): its listing; only with a / so plain words stay Claude's
        for base in (cwd, s.get("cwd", cwd)):
            full = os.path.normpath(os.path.join(base, os.path.expanduser(w.removeprefix("file://").rstrip(".:,"))))
            if "/" in w and os.path.isdir(full):
                return zid, full, None
    for w in words[-1:]:  # only a name: the file shown earlier or in the project with it; several: pick one
        hits, line = files_named(w, s.get("cwd", cwd), tmux("capture-pane", "-p", "-J", "-S", "-3000", "-t", pane) or "")
        if len(hits) == 1:
            return zid, hits[0], line
        if hits:
            return zid, "pick", (FILE_NAME.match(w)[1], line, hits)
    # nothing there: the word itself, or joined where it ends in a wrap-ish character (a long link)
    word = next((v for v in words[:-1] if re.search(r"[-/_.?=&]$", words[-1])), words[-1] if words else "")
    if "://" not in word and LOOKS_LIKE_FILE.match(word):
        return zid, None, word
    url = next((u for u in (link, *(w.rstrip(".,;:)") for w in words)) if re.match(r"https?://\S+$", u or "")), None)
    if url:  # a plain click opens it (iTerm would need cmd-click)
        return zid, "url", url
    return None


def cmd_ispath(pane, x, y, link=""):
    """Exit 0 when a click lands on a file path: zidev handles it and the app never gets the click
    (Claude Code would open a relative path in the browser)."""
    sys.exit(0 if clicked_path(pane, x, y, link) else 1)


def cmd_click(pane, x, y):
    """A click in a pane (tmux MouseUp1Pane): a file path under it opens in the preview."""
    hit = clicked_path(pane, x, y, tmux("show", "-gv", "@zidev_link") or "")
    if not hit:
        return
    zid, path, line = hit
    if path == "pick":
        pick_file(zid, pane, *line)
    elif path == "bang":  # a click copies it; a double click types it into the prompt (bang_prompt)
        copy_text(line)
        tmux("display-message", "-d", "1500", f"copied: {line}")
    elif path == "url":
        subprocess.Popen([OPENER, line], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    elif path:
        show_file(zid, pane, path, line)
    else:
        tmux("display-message", "-d", "2000", f"no such file: {line}")


def copy_text(text):
    copy = os.environ.get("ZIDEV_COPY", "pbcopy")  # override for tests: your clipboard stays
    if shutil.which(copy):
        subprocess.run([copy], input=text.encode())
    else:
        tmux("set-buffer", "-w", text)


def cmd_bang(pane, x, y, run=""):
    """A double click on a `! command` in Claude: typed into its prompt, not sent (⏎ is yours).
    cmd-click (the zidev app, `run`): typed and sent. Exit 1 when there is none: the double click
    selects a word as usual, a cmd-click is a plain click."""
    hit = clicked_path(pane, x, y)
    if not hit or hit[1] != "bang":
        if run:  # cmd-click on anything else: a plain click (an exit 1 would show tmux's "returned 1")
            return cmd_click(pane, x, y)
        sys.exit(1)
    tmux("send-keys", "-t", pane, "-l", "!")
    time.sleep(0.15)  # Claude switches to its bash mode first
    tmux("send-keys", "-t", pane, "-l", hit[2])
    if run:
        time.sleep(0.1)
        tmux("send-keys", "-t", pane, "Enter")


