def cmd_run(zid):
    """Pane process of a session: runs Claude, offers restart when it exits."""
    os.environ["ZIDEV_ID"] = zid
    while True:
        s = next((s for s in load_state()["sessions"] if s["id"] == zid), None)
        if not s:
            return
        with edit_state() as d:
            d["last"] = zid
        cid = read_status(zid).get("claude_id") or zid
        # Claude saves a session only after its first message; an unused one can't be resumed
        saved = glob.glob(os.path.expanduser(f"~/.claude/projects/*/{cid}.jsonl"))
        args = [claude_bin(), "--settings", HOOK_SETTINGS, "--resume" if saved else "--session-id", cid]
        if s.get("prompt"):
